<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Akati OS Center" Width="1120" Height="700" MinWidth="980" MinHeight="620"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ResizeMode="CanMinimize" WindowStartupLocation="CenterScreen"
        FontFamily="Segoe UI Variable Text, Segoe UI, Leelawadee UI, Tahoma" FontSize="13"
        Foreground="#F1ECF8" TextOptions.TextFormattingMode="Display">
    <Window.Resources>
        <SolidColorBrush x:Key="Accent" Color="#8A3FD6"/>
        <SolidColorBrush x:Key="Accent2" Color="#B07CF0"/>
        <SolidColorBrush x:Key="CardBg" Color="#17121F"/>
        <SolidColorBrush x:Key="CardBorder" Color="#2A2238"/>
        <SolidColorBrush x:Key="MutedBrush" Color="#9C93AD"/>
        <SolidColorBrush x:Key="Good" Color="#5FD38D"/>
        <LinearGradientBrush x:Key="AccentGradient" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#A35CF0" Offset="0"/>
            <GradientStop Color="#6C3BC8" Offset="1"/>
        </LinearGradientBrush>

        <Style x:Key="Card" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource CardBg}"/>
            <Setter Property="BorderBrush" Value="{StaticResource CardBorder}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="12"/>
            <Setter Property="Padding" Value="18"/>
        </Style>

        <Style x:Key="Glyph" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Segoe Fluent Icons, Segoe MDL2 Assets"/>
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <Style x:Key="Muted" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource MutedBrush}"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>

        <Style x:Key="CardTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>

        <Style x:Key="Label" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{StaticResource MutedBrush}"/>
        </Style>

        <Style x:Key="Nav" TargetType="RadioButton">
            <Setter Property="Foreground" Value="#C9C1D8"/>
            <Setter Property="Margin" Value="0,2"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="GroupName" Value="Nav"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="Bd" Background="Transparent" CornerRadius="8" Padding="14,10" BorderThickness="2,0,0,0" BorderBrush="Transparent">
                            <ContentPresenter VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#1E1729"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#2A1F3D"/>
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource Accent2}"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="Primary" TargetType="Button">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="16,9"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{StaticResource AccentGradient}" CornerRadius="8" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.88"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.4"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="Secondary" TargetType="Button">
            <Setter Property="Foreground" Value="#E4DDF2"/>
            <Setter Property="Padding" Value="14,8"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="#221A2E" BorderBrush="#33294A" BorderThickness="1" CornerRadius="8" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#2C2240"/>
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource Accent}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.4"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="Action" TargetType="Button">
            <Setter Property="Foreground" Value="#E4DDF2"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Margin" Value="0,0,0,10"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="#1C1626" BorderBrush="#2A2238" BorderThickness="1" CornerRadius="10" Padding="14,12">
                            <ContentPresenter HorizontalAlignment="Stretch" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource Accent}"/>
                                <Setter TargetName="Bd" Property="Background" Value="#221A2E"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.5"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="Chrome" TargetType="Button">
            <Setter Property="Foreground" Value="#C9C1D8"/>
            <Setter Property="Width" Value="44"/>
            <Setter Property="Height" Value="34"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="Transparent" CornerRadius="6">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#2A2238"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="Switch" TargetType="CheckBox">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <Border x:Name="Track" Width="46" Height="24" CornerRadius="12" Background="#2E2640" BorderBrush="#41365A" BorderThickness="1">
                            <Ellipse x:Name="Thumb" Width="16" Height="16" Fill="#C9C1D8" HorizontalAlignment="Left" Margin="4,0"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Track" Property="Background" Value="{StaticResource AccentGradient}"/>
                                <Setter TargetName="Track" Property="BorderBrush" Value="{StaticResource Accent2}"/>
                                <Setter TargetName="Thumb" Property="HorizontalAlignment" Value="Right"/>
                                <Setter TargetName="Thumb" Property="Fill" Value="White"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Track" Property="Opacity" Value="0.45"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="Tick" TargetType="CheckBox">
            <Setter Property="Foreground" Value="#E4DDF2"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <StackPanel Orientation="Horizontal">
                            <Border x:Name="Box" Width="18" Height="18" CornerRadius="5" Background="#221A2E" BorderBrush="#4A3E66" BorderThickness="1" VerticalAlignment="Center">
                                <TextBlock x:Name="Mark" Text="&#xE73E;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="11" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed"/>
                            </Border>
                            <ContentPresenter Margin="10,0,0,0" VerticalAlignment="Center"/>
                        </StackPanel>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Box" Property="Background" Value="{StaticResource Accent}"/>
                                <Setter TargetName="Box" Property="BorderBrush" Value="{StaticResource Accent2}"/>
                                <Setter TargetName="Mark" Property="Visibility" Value="Visible"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="Meter" TargetType="ProgressBar">
            <Setter Property="Height" Value="6"/>
            <Setter Property="Minimum" Value="0"/>
            <Setter Property="Maximum" Value="100"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ProgressBar">
                        <Grid>
                            <Border x:Name="PART_Track" Background="#2A2238" CornerRadius="3"/>
                            <Border x:Name="PART_Indicator" Background="{StaticResource AccentGradient}" CornerRadius="3" HorizontalAlignment="Left"/>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="ScrollBar">
            <Setter Property="Width" Value="6"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ScrollBar">
                        <Track x:Name="PART_Track" IsDirectionReversed="True">
                            <Track.Thumb>
                                <Thumb>
                                    <Thumb.Template>
                                        <ControlTemplate TargetType="Thumb">
                                            <Border Background="#3A3050" CornerRadius="3"/>
                                        </ControlTemplate>
                                    </Thumb.Template>
                                </Thumb>
                            </Track.Thumb>
                        </Track>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border CornerRadius="14" Background="#0E0B14" BorderBrush="#2A2238" BorderThickness="1">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="248"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Sidebar -->
            <Border Grid.Column="0" Background="#120E1A" CornerRadius="14,0,0,14" BorderBrush="#221B2E" BorderThickness="0,0,1,0">
                <DockPanel Margin="14">
                    <Border DockPanel.Dock="Top" x:Name="Brand" CornerRadius="12" Height="128" ClipToBounds="True" Margin="0,0,0,18">
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0,1" EndPoint="1,0">
                                <GradientStop Color="#173A72" Offset="0"/>
                                <GradientStop Color="#1A1030" Offset="0.5"/>
                                <GradientStop Color="#4A1C7A" Offset="1"/>
                            </LinearGradientBrush>
                        </Border.Background>
                        <Grid>
                            <Image x:Name="BrandImage" Stretch="UniformToFill" Opacity="0.9"/>
                            <StackPanel VerticalAlignment="Bottom" Margin="16,0,16,14">
                                <StackPanel Orientation="Horizontal">
                                    <Image x:Name="LogoImage" Width="30" Height="30" Margin="0,0,10,0"/>
                                    <TextBlock Text="AKATI OS" FontSize="20" FontWeight="Bold" VerticalAlignment="Center"/>
                                </StackPanel>
                                <TextBlock Text="CENTER" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource Accent2}" Margin="40,0,0,0"/>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <StackPanel DockPanel.Dock="Bottom">
                        <Button x:Name="LangButton" Style="{StaticResource Secondary}" Margin="0,0,0,8">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Style="{StaticResource Glyph}" Text="&#xE774;" FontSize="14" Margin="0,0,8,0"/>
                                <TextBlock x:Name="LangLabel" Text="ภาษาไทย"/>
                            </StackPanel>
                        </Button>
                        <Border Background="#1C1626" CornerRadius="8" Padding="12,9" BorderBrush="#2A2238" BorderThickness="1">
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                <TextBlock Style="{StaticResource Glyph}" Text="&#xE83D;" FontSize="13" Foreground="{StaticResource Accent2}" Margin="0,0,8,0"/>
                                <TextBlock x:Name="AdminLabel" Tag="t:admin" Text="Administrator mode" FontSize="12" FontWeight="SemiBold"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <StackPanel>
                        <TextBlock Tag="t:menu" Text="MENU" Style="{StaticResource Label}" Margin="14,0,0,8"/>
                        <RadioButton x:Name="NavDashboard" Style="{StaticResource Nav}" IsChecked="True">
                            <StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource Glyph}" Text="&#xE80F;" Margin="0,0,14,0"/><TextBlock Tag="t:nav.dashboard" Text="Dashboard"/></StackPanel>
                        </RadioButton>
                        <RadioButton x:Name="NavGaming" Style="{StaticResource Nav}">
                            <StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource Glyph}" Text="&#xE7FC;" Margin="0,0,14,0"/><TextBlock Tag="t:nav.gaming" Text="Gaming apps"/></StackPanel>
                        </RadioButton>
                        <RadioButton x:Name="NavTweaks" Style="{StaticResource Nav}">
                            <StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource Glyph}" Text="&#xE9E9;" Margin="0,0,14,0"/><TextBlock Tag="t:nav.tweaks" Text="Tweaks"/></StackPanel>
                        </RadioButton>
                        <RadioButton x:Name="NavCleaner" Style="{StaticResource Nav}">
                            <StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource Glyph}" Text="&#xE74D;" Margin="0,0,14,0"/><TextBlock Tag="t:nav.cleaner" Text="Cleaner"/></StackPanel>
                        </RadioButton>
                        <RadioButton x:Name="NavAppearance" Style="{StaticResource Nav}">
                            <StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource Glyph}" Text="&#xE771;" Margin="0,0,14,0"/><TextBlock Tag="t:nav.appearance" Text="Appearance"/></StackPanel>
                        </RadioButton>
                        <RadioButton x:Name="NavAbout" Style="{StaticResource Nav}">
                            <StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource Glyph}" Text="&#xE946;" Margin="0,0,14,0"/><TextBlock Tag="t:nav.about" Text="About"/></StackPanel>
                        </RadioButton>
                    </StackPanel>
                </DockPanel>
            </Border>

            <!-- Main -->
            <Grid Grid.Column="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="48"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="34"/>
                </Grid.RowDefinitions>

                <Grid x:Name="TitleBar" Grid.Row="0" Background="Transparent">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="28,0,0,0">
                        <TextBlock x:Name="PageTitle" Text="Dashboard" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource MutedBrush}"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,0,8,0">
                        <Button x:Name="MinButton" Style="{StaticResource Chrome}"><TextBlock Style="{StaticResource Glyph}" Text="&#xE921;" FontSize="11"/></Button>
                        <Button x:Name="CloseButton" Style="{StaticResource Chrome}"><TextBlock Style="{StaticResource Glyph}" Text="&#xE8BB;" FontSize="11"/></Button>
                    </StackPanel>
                </Grid>

                <Grid Grid.Row="1" Margin="28,0,28,0">

                    <!-- Dashboard -->
                    <ScrollViewer x:Name="PageDashboard" VerticalScrollBarVisibility="Auto">
                        <StackPanel>
                            <Grid Margin="0,0,0,16">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="16"/>
                                    <ColumnDefinition Width="260"/>
                                </Grid.ColumnDefinitions>
                                <Border Style="{StaticResource Card}" Padding="0" ClipToBounds="True">
                                    <Grid>
                                        <Image x:Name="HeroImage" Stretch="UniformToFill" Opacity="0.55"/>
                                        <StackPanel Margin="24,22">
                                            <TextBlock Tag="t:welcome" Text="Welcome back" Foreground="{StaticResource Accent2}" FontWeight="SemiBold"/>
                                            <TextBlock x:Name="PcName" Text="PC" FontSize="30" FontWeight="Bold" Margin="0,4,0,6"/>
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Style="{StaticResource Glyph}" Text="&#xE7F8;" FontSize="12" Foreground="{StaticResource MutedBrush}" Margin="0,0,8,0"/>
                                                <TextBlock x:Name="OsLine" Text="Windows" Foreground="{StaticResource MutedBrush}"/>
                                            </StackPanel>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                                <Border Grid.Column="2" Style="{StaticResource Card}">
                                    <StackPanel>
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Style="{StaticResource Glyph}" Text="&#xE946;" FontSize="13" Foreground="{StaticResource Accent2}" Margin="0,0,8,0"/>
                                            <TextBlock Tag="t:version" Text="Akati OS version" Style="{StaticResource Label}" VerticalAlignment="Center"/>
                                        </StackPanel>
                                        <TextBlock x:Name="VersionBig" Text="v1.3.0" FontSize="30" FontWeight="Bold" Margin="0,8,0,0"/>
                                        <TextBlock x:Name="EditionText" Text="Windows 11" Style="{StaticResource Muted}"/>
                                        <TextBlock x:Name="UpdateHint" Text="" Foreground="{StaticResource Good}" FontSize="12" Margin="0,6,0,0" TextWrapping="Wrap"/>
                                    </StackPanel>
                                </Border>
                            </Grid>

                            <Border Style="{StaticResource Card}" Padding="18,12" Margin="0,0,0,16">
                                <WrapPanel x:Name="SpecsPanel">
                                    <StackPanel Orientation="Horizontal" Margin="0,0,28,0"><TextBlock Text="CPU" Style="{StaticResource Label}" Margin="0,0,8,0" VerticalAlignment="Center"/><TextBlock x:Name="CpuName" Text="-" FontWeight="SemiBold"/></StackPanel>
                                    <StackPanel Orientation="Horizontal" Margin="0,0,28,0"><TextBlock Text="GPU" Style="{StaticResource Label}" Margin="0,0,8,0" VerticalAlignment="Center"/><TextBlock x:Name="GpuName" Text="-" FontWeight="SemiBold"/></StackPanel>
                                    <StackPanel Orientation="Horizontal" Margin="0,0,28,0"><TextBlock Text="RAM" Style="{StaticResource Label}" Margin="0,0,8,0" VerticalAlignment="Center"/><TextBlock x:Name="RamName" Text="-" FontWeight="SemiBold"/></StackPanel>
                                    <StackPanel Orientation="Horizontal"><TextBlock Text="C:" Style="{StaticResource Label}" Margin="0,0,8,0" VerticalAlignment="Center"/><TextBlock x:Name="DiskName" Text="-" FontWeight="SemiBold"/></StackPanel>
                                </WrapPanel>
                            </Border>

                            <UniformGrid Columns="3" Margin="-8,0,-8,16">
                                <Border Style="{StaticResource Card}" Margin="8,0">
                                    <StackPanel>
                                        <Grid>
                                            <TextBlock Tag="t:cpu" Text="CPU USAGE" Style="{StaticResource Label}" VerticalAlignment="Center"/>
                                            <TextBlock x:Name="CpuValue" Text="0%" FontSize="28" FontWeight="Bold" HorizontalAlignment="Right"/>
                                        </Grid>
                                        <ProgressBar x:Name="CpuBar" Style="{StaticResource Meter}" Margin="0,12,0,0"/>
                                    </StackPanel>
                                </Border>
                                <Border Style="{StaticResource Card}" Margin="8,0">
                                    <StackPanel>
                                        <Grid>
                                            <TextBlock Tag="t:ram" Text="RAM USAGE" Style="{StaticResource Label}" VerticalAlignment="Center"/>
                                            <TextBlock x:Name="RamValue" Text="0%" FontSize="28" FontWeight="Bold" HorizontalAlignment="Right"/>
                                        </Grid>
                                        <ProgressBar x:Name="RamBar" Style="{StaticResource Meter}" Margin="0,12,0,0"/>
                                        <TextBlock x:Name="RamDetail" Text="" Style="{StaticResource Muted}" FontSize="11" Margin="0,8,0,0"/>
                                    </StackPanel>
                                </Border>
                                <Border Style="{StaticResource Card}" Margin="8,0">
                                    <StackPanel>
                                        <Grid>
                                            <TextBlock Tag="t:gpu" Text="GPU USAGE" Style="{StaticResource Label}" VerticalAlignment="Center"/>
                                            <TextBlock x:Name="GpuValue" Text="0%" FontSize="28" FontWeight="Bold" HorizontalAlignment="Right"/>
                                        </Grid>
                                        <ProgressBar x:Name="GpuBar" Style="{StaticResource Meter}" Margin="0,12,0,0"/>
                                    </StackPanel>
                                </Border>
                            </UniformGrid>

                            <Border Style="{StaticResource Card}" Margin="0,0,0,16">
                                <StackPanel>
                                    <TextBlock Tag="t:quick" Text="Quick actions" Style="{StaticResource CardTitle}" Margin="0,0,0,14"/>
                                    <UniformGrid Columns="3" Margin="-5,0">
                                        <Button x:Name="QuickClean" Style="{StaticResource Action}" Margin="5,0">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Style="{StaticResource Glyph}" Text="&#xE74D;" Foreground="{StaticResource Accent2}" Margin="0,0,12,0"/>
                                                <StackPanel><TextBlock Tag="t:quick.clean" Text="Clean temp files" FontWeight="SemiBold"/><TextBlock Tag="t:quick.clean.d" Text="Free up disk space" Style="{StaticResource Muted}" FontSize="11"/></StackPanel>
                                            </StackPanel>
                                        </Button>
                                        <Button x:Name="QuickUpdate" Style="{StaticResource Action}" Margin="5,0">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Style="{StaticResource Glyph}" Text="&#xE895;" Foreground="{StaticResource Accent2}" Margin="0,0,12,0"/>
                                                <StackPanel><TextBlock Tag="t:quick.update" Text="Check for updates" FontWeight="SemiBold"/><TextBlock Tag="t:quick.update.d" Text="Compare with GitHub" Style="{StaticResource Muted}" FontSize="11"/></StackPanel>
                                            </StackPanel>
                                        </Button>
                                        <Button x:Name="QuickAtlas" Style="{StaticResource Action}" Margin="5,0">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Style="{StaticResource Glyph}" Text="&#xE8B7;" Foreground="{StaticResource Accent2}" Margin="0,0,12,0"/>
                                                <StackPanel><TextBlock Tag="t:quick.atlas" Text="Open Atlas folder" FontWeight="SemiBold"/><TextBlock Tag="t:quick.atlas.d" Text="All other settings" Style="{StaticResource Muted}" FontSize="11"/></StackPanel>
                                            </StackPanel>
                                        </Button>
                                    </UniformGrid>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>

                    <!-- Gaming apps -->
                    <ScrollViewer x:Name="PageGaming" VerticalScrollBarVisibility="Auto" Visibility="Collapsed">
                        <StackPanel>
                            <TextBlock Tag="t:gaming.title" Text="Gaming apps" FontSize="24" FontWeight="Bold"/>
                            <TextBlock Tag="t:gaming.sub" Text="Installed with WinGet from official sources. Apps that are already installed are skipped." Style="{StaticResource Muted}" Margin="0,4,0,18"/>
                            <Border Style="{StaticResource Card}" Padding="8" Margin="0,0,0,16">
                                <StackPanel x:Name="AppsList"/>
                            </Border>
                            <Border Style="{StaticResource Card}" Margin="0,0,0,16">
                                <StackPanel>
                                    <TextBlock Tag="t:gpu.title" Text="GPU drivers" Style="{StaticResource CardTitle}"/>
                                    <TextBlock Tag="t:gpu.sub" Text="Opens the official driver download page." Style="{StaticResource Muted}" Margin="0,4,0,14"/>
                                    <StackPanel Orientation="Horizontal">
                                        <Button x:Name="GpuNvidia" Style="{StaticResource Secondary}" Content="NVIDIA" Margin="0,0,10,0" MinWidth="110"/>
                                        <Button x:Name="GpuAmd" Style="{StaticResource Secondary}" Content="AMD" Margin="0,0,10,0" MinWidth="110"/>
                                        <Button x:Name="GpuIntel" Style="{StaticResource Secondary}" Content="Intel" MinWidth="110"/>
                                    </StackPanel>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>

                    <!-- Tweaks -->
                    <ScrollViewer x:Name="PageTweaks" VerticalScrollBarVisibility="Auto" Visibility="Collapsed">
                        <StackPanel>
                            <TextBlock Tag="t:tweaks.title" Text="Tweaks" FontSize="24" FontWeight="Bold"/>
                            <TextBlock Tag="t:tweaks.sub" Text="Each switch shows the current state of your PC. Turn a tweak off again if games run worse." Style="{StaticResource Muted}" Margin="0,4,0,18"/>
                            <Border Style="{StaticResource Card}" Padding="8" Margin="0,0,0,16">
                                <StackPanel x:Name="TweaksList"/>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>

                    <!-- Cleaner -->
                    <ScrollViewer x:Name="PageCleaner" VerticalScrollBarVisibility="Auto" Visibility="Collapsed">
                        <StackPanel>
                            <TextBlock Tag="t:cleaner.title" Text="Cleaner" FontSize="24" FontWeight="Bold"/>
                            <TextBlock Tag="t:cleaner.sub" Text="Deletes temporary files. Files that are in use are skipped." Style="{StaticResource Muted}" Margin="0,4,0,18"/>
                            <Border Style="{StaticResource Card}" Margin="0,0,0,16">
                                <StackPanel>
                                    <StackPanel x:Name="CleanList"/>
                                    <Border Height="1" Background="#2A2238" Margin="0,8,0,16"/>
                                    <Grid>
                                        <StackPanel VerticalAlignment="Center">
                                            <TextBlock Tag="t:cleaner.total" Text="Selected" Style="{StaticResource Label}"/>
                                            <TextBlock x:Name="CleanTotal" Text="-" FontSize="22" FontWeight="Bold"/>
                                        </StackPanel>
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                            <Button x:Name="ScanButton" Style="{StaticResource Secondary}" Margin="0,0,10,0">
                                                <StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource Glyph}" Text="&#xE72C;" FontSize="13" Margin="0,0,8,0"/><TextBlock Tag="t:cleaner.scan" Text="Scan"/></StackPanel>
                                            </Button>
                                            <Button x:Name="CleanButton" Style="{StaticResource Primary}">
                                                <StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource Glyph}" Text="&#xE74D;" FontSize="13" Margin="0,0,8,0"/><TextBlock Tag="t:cleaner.clean" Text="Clean now"/></StackPanel>
                                            </Button>
                                        </StackPanel>
                                    </Grid>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>

                    <!-- Appearance -->
                    <ScrollViewer x:Name="PageAppearance" VerticalScrollBarVisibility="Auto" Visibility="Collapsed">
                        <StackPanel>
                            <TextBlock Tag="t:appearance.title" Text="Appearance" FontSize="24" FontWeight="Bold"/>
                            <TextBlock Tag="t:appearance.sub" Text="Pick an Akati OS theme. Windows applies it right away." Style="{StaticResource Muted}" Margin="0,4,0,18"/>
                            <UniformGrid x:Name="ThemesGrid" Columns="3" Margin="-8,0,-8,16"/>
                        </StackPanel>
                    </ScrollViewer>

                    <!-- About -->
                    <ScrollViewer x:Name="PageAbout" VerticalScrollBarVisibility="Auto" Visibility="Collapsed">
                        <StackPanel>
                            <Border Style="{StaticResource Card}" Margin="0,0,0,16">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <Image x:Name="AboutLogo" Width="72" Height="72" Margin="0,0,20,0"/>
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <TextBlock Text="Akati OS" FontSize="26" FontWeight="Bold"/>
                                        <TextBlock x:Name="AboutVersion" Text="v1.3.0" Style="{StaticResource Muted}"/>
                                        <TextBlock x:Name="UpdateStatus" Text="" Margin="0,6,0,0" TextWrapping="Wrap"/>
                                    </StackPanel>
                                    <Button x:Name="UpdateButton" Grid.Column="2" Style="{StaticResource Primary}" VerticalAlignment="Center">
                                        <StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource Glyph}" Text="&#xE895;" FontSize="13" Margin="0,0,8,0"/><TextBlock Tag="t:quick.update" Text="Check for updates"/></StackPanel>
                                    </Button>
                                </Grid>
                            </Border>
                            <Border Style="{StaticResource Card}" Margin="0,0,0,16">
                                <StackPanel>
                                    <TextBlock Tag="t:links" Text="Links" Style="{StaticResource CardTitle}" Margin="0,0,0,12"/>
                                    <WrapPanel>
                                        <Button x:Name="LinkGithub" Style="{StaticResource Secondary}" Margin="0,0,10,10"><StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource Glyph}" Text="&#xE774;" FontSize="13" Margin="0,0,8,0"/><TextBlock Text="GitHub"/></StackPanel></Button>
                                        <Button x:Name="LinkOptions" Style="{StaticResource Secondary}" Margin="0,0,10,10"><StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource Glyph}" Text="&#xE897;" FontSize="13" Margin="0,0,8,0"/><TextBlock Tag="t:link.options" Text="Options guide"/></StackPanel></Button>
                                        <Button x:Name="LinkAtlasFolder" Style="{StaticResource Secondary}" Margin="0,0,10,10"><StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource Glyph}" Text="&#xE8B7;" FontSize="13" Margin="0,0,8,0"/><TextBlock Tag="t:quick.atlas" Text="Open Atlas folder"/></StackPanel></Button>
                                        <Button x:Name="LinkAtlas" Style="{StaticResource Secondary}" Margin="0,0,10,10"><StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource Glyph}" Text="&#xE71B;" FontSize="13" Margin="0,0,8,0"/><TextBlock Text="AtlasOS"/></StackPanel></Button>
                                    </WrapPanel>
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource Card}" Margin="0,0,0,16">
                                <StackPanel>
                                    <TextBlock Tag="t:credits" Text="Credits" Style="{StaticResource CardTitle}" Margin="0,0,0,8"/>
                                    <TextBlock Tag="t:credits.text" Text="Akati OS is based on AtlasOS by the Atlas team and is licensed under GPL-3.0. It is not an official AtlasOS project. AME Wizard by Ameliorated." Style="{StaticResource Muted}"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>

                <Border Grid.Row="2" BorderBrush="#221B2E" BorderThickness="0,1,0,0">
                    <Grid Margin="28,0">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Ellipse x:Name="StatusDot" Width="7" Height="7" Fill="{StaticResource Good}" Margin="0,0,8,0"/>
                            <TextBlock x:Name="StatusText" Tag="t:ready" Text="Ready" FontSize="12" Foreground="{StaticResource MutedBrush}"/>
                        </StackPanel>
                        <TextBlock x:Name="FooterVersion" Text="Akati OS" FontSize="12" Foreground="#6E6680" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                    </Grid>
                </Border>
            </Grid>
        </Grid>
    </Border>
</Window>
