<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Akati OS Center" Width="1120" Height="700" MinWidth="860" MinHeight="560"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ResizeMode="CanMinimize" WindowStartupLocation="CenterScreen"
        FontFamily="Segoe UI Variable Text, Segoe UI, Leelawadee UI, Tahoma" FontSize="13"
        Foreground="{DynamicResource Text}" TextOptions.TextFormattingMode="Display">
    <Window.Resources>
        <SolidColorBrush x:Key="Accent" Color="#8A3FD6"/>
        <SolidColorBrush x:Key="Accent2" Color="#B07CF0"/>
        <SolidColorBrush x:Key="CardBg" Color="#2A2A2C"/>
        <SolidColorBrush x:Key="CardBorder" Color="#38383A"/>
        <SolidColorBrush x:Key="CardBorderHover" Color="#4C4C50"/>
        <SolidColorBrush x:Key="MutedBrush" Color="#98989D"/>
        <SolidColorBrush x:Key="Good" Color="#5FD38D"/>
        <!-- Theme colors (dark). AkatiCenter.ps1 changes them for the light look -->
        <SolidColorBrush x:Key="Text" Color="#F5F5F7"/>
        <SolidColorBrush x:Key="Text2" Color="#EBEBF0"/>
        <SolidColorBrush x:Key="Text3" Color="#D1D1D6"/>
        <SolidColorBrush x:Key="RootBg" Color="#1C1C1E"/>
        <SolidColorBrush x:Key="SidebarBg" Color="#232325"/>
        <SolidColorBrush x:Key="Line" Color="#38383A"/>
        <SolidColorBrush x:Key="Fill" Color="#3A3A3C"/>
        <SolidColorBrush x:Key="FillHover" Color="#48484A"/>
        <SolidColorBrush x:Key="Field" Color="#2E2E30"/>
        <SolidColorBrush x:Key="Popup" Color="#2C2C2E"/>
        <SolidColorBrush x:Key="Handle" Color="#5A5A5E"/>
        <SolidColorBrush x:Key="SegmentOn" Color="#4A4A4D"/>
        <LinearGradientBrush x:Key="AccentGradient" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#A35CF0" Offset="0"/>
            <GradientStop Color="#6C3BC8" Offset="1"/>
        </LinearGradientBrush>

        <!-- Keyboard focus: an accent ring (set on buttons, switches and boxes by AkatiCenter.ps1) -->
        <Style x:Key="FocusRing">
            <Setter Property="Control.Template">
                <Setter.Value>
                    <ControlTemplate>
                        <Rectangle Margin="-3" RadiusX="8" RadiusY="8" Stroke="{DynamicResource Accent2}" StrokeThickness="2"/>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <!-- Placeholder bar that pulses while a value is loading -->
        <Style x:Key="Shimmer" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource Fill}"/>
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="Height" Value="14"/>
            <Setter Property="Margin" Value="0,8"/>
            <Style.Triggers>
                <EventTrigger RoutedEvent="FrameworkElement.Loaded">
                    <BeginStoryboard><Storyboard>
                        <DoubleAnimation Storyboard.TargetProperty="Opacity" From="0.35" To="0.9" Duration="0:0:0.8" AutoReverse="True" RepeatBehavior="Forever"/>
                    </Storyboard></BeginStoryboard>
                </EventTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="Card" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource CardBg}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource CardBorder}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="Padding" Value="16"/>
            <!-- The border lights up a little under the mouse -->
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="BorderBrush" Value="{DynamicResource CardBorderHover}"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="Glyph" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Segoe Fluent Icons, Segoe MDL2 Assets"/>
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <Style x:Key="Muted" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource MutedBrush}"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>

        <Style x:Key="CardTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>

        <!-- Gray heading above a grouped list, like macOS System Settings -->
        <Style x:Key="Section" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{DynamicResource MutedBrush}"/>
            <Setter Property="Margin" Value="4,0,0,8"/>
        </Style>

        <Style x:Key="Label" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{DynamicResource MutedBrush}"/>
        </Style>

        <Style x:Key="Nav" TargetType="RadioButton">
            <Setter Property="Foreground" Value="{DynamicResource Text3}"/>
            <Setter Property="Margin" Value="0,1"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="GroupName" Value="Nav"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="Bd" Background="Transparent" CornerRadius="6" Padding="8,5">
                            <ContentPresenter VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Field}"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Accent}"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="NavIcon" TargetType="Border">
            <Setter Property="Width" Value="22"/>
            <Setter Property="Height" Value="22"/>
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="Margin" Value="0,0,10,0"/>
        </Style>
        <Style x:Key="NavGlyph" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Segoe Fluent Icons, Segoe MDL2 Assets"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <Style x:Key="Primary" TargetType="Button">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="14,7"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" RenderTransformOrigin="0.5,0.5" Background="{DynamicResource Accent}" CornerRadius="6" Padding="{TemplateBinding Padding}"><Border.RenderTransform><ScaleTransform x:Name="Press"/></Border.RenderTransform>
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsPressed" Value="True">
                                <Trigger.EnterActions><BeginStoryboard><Storyboard>
                                    <DoubleAnimation Storyboard.TargetName="Press" Storyboard.TargetProperty="ScaleX" To="0.96" Duration="0:0:0.08"/>
                                    <DoubleAnimation Storyboard.TargetName="Press" Storyboard.TargetProperty="ScaleY" To="0.96" Duration="0:0:0.08"/>
                                </Storyboard></BeginStoryboard></Trigger.EnterActions>
                                <Trigger.ExitActions><BeginStoryboard><Storyboard>
                                    <DoubleAnimation Storyboard.TargetName="Press" Storyboard.TargetProperty="ScaleX" To="1" Duration="0:0:0.15"/>
                                    <DoubleAnimation Storyboard.TargetName="Press" Storyboard.TargetProperty="ScaleY" To="1" Duration="0:0:0.15"/>
                                </Storyboard></BeginStoryboard></Trigger.ExitActions>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.88"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.4"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="Secondary" TargetType="Button">
            <Setter Property="Foreground" Value="{DynamicResource Text2}"/>
            <Setter Property="Padding" Value="12,6"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" RenderTransformOrigin="0.5,0.5" Background="{DynamicResource Fill}" BorderBrush="{DynamicResource FillHover}" BorderThickness="0,1,0,0" CornerRadius="6" Padding="{TemplateBinding Padding}"><Border.RenderTransform><ScaleTransform x:Name="Press"/></Border.RenderTransform>
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsPressed" Value="True">
                                <Trigger.EnterActions><BeginStoryboard><Storyboard>
                                    <DoubleAnimation Storyboard.TargetName="Press" Storyboard.TargetProperty="ScaleX" To="0.96" Duration="0:0:0.08"/>
                                    <DoubleAnimation Storyboard.TargetName="Press" Storyboard.TargetProperty="ScaleY" To="0.96" Duration="0:0:0.08"/>
                                </Storyboard></BeginStoryboard></Trigger.EnterActions>
                                <Trigger.ExitActions><BeginStoryboard><Storyboard>
                                    <DoubleAnimation Storyboard.TargetName="Press" Storyboard.TargetProperty="ScaleX" To="1" Duration="0:0:0.15"/>
                                    <DoubleAnimation Storyboard.TargetName="Press" Storyboard.TargetProperty="ScaleY" To="1" Duration="0:0:0.15"/>
                                </Storyboard></BeginStoryboard></Trigger.ExitActions>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource FillHover}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.4"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- App Store style buttons: gray capsule (Get, Open), accent capsule (Update) -->
        <Style x:Key="Pill" TargetType="Button">
            <Setter Property="Foreground" Value="{DynamicResource Accent2}"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Padding" Value="16,5"/>
            <Setter Property="MinWidth" Value="84"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" RenderTransformOrigin="0.5,0.5" Background="{DynamicResource Fill}" CornerRadius="14" Padding="{TemplateBinding Padding}"><Border.RenderTransform><ScaleTransform x:Name="Press"/></Border.RenderTransform>
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsPressed" Value="True">
                                <Trigger.EnterActions><BeginStoryboard><Storyboard>
                                    <DoubleAnimation Storyboard.TargetName="Press" Storyboard.TargetProperty="ScaleX" To="0.96" Duration="0:0:0.08"/>
                                    <DoubleAnimation Storyboard.TargetName="Press" Storyboard.TargetProperty="ScaleY" To="0.96" Duration="0:0:0.08"/>
                                </Storyboard></BeginStoryboard></Trigger.EnterActions>
                                <Trigger.ExitActions><BeginStoryboard><Storyboard>
                                    <DoubleAnimation Storyboard.TargetName="Press" Storyboard.TargetProperty="ScaleX" To="1" Duration="0:0:0.15"/>
                                    <DoubleAnimation Storyboard.TargetName="Press" Storyboard.TargetProperty="ScaleY" To="1" Duration="0:0:0.15"/>
                                </Storyboard></BeginStoryboard></Trigger.ExitActions>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource FillHover}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.4"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="PillAccent" TargetType="Button" BasedOn="{StaticResource Pill}">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" RenderTransformOrigin="0.5,0.5" Background="{DynamicResource Accent}" CornerRadius="14" Padding="{TemplateBinding Padding}"><Border.RenderTransform><ScaleTransform x:Name="Press"/></Border.RenderTransform>
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsPressed" Value="True">
                                <Trigger.EnterActions><BeginStoryboard><Storyboard>
                                    <DoubleAnimation Storyboard.TargetName="Press" Storyboard.TargetProperty="ScaleX" To="0.96" Duration="0:0:0.08"/>
                                    <DoubleAnimation Storyboard.TargetName="Press" Storyboard.TargetProperty="ScaleY" To="0.96" Duration="0:0:0.08"/>
                                </Storyboard></BeginStoryboard></Trigger.EnterActions>
                                <Trigger.ExitActions><BeginStoryboard><Storyboard>
                                    <DoubleAnimation Storyboard.TargetName="Press" Storyboard.TargetProperty="ScaleX" To="1" Duration="0:0:0.15"/>
                                    <DoubleAnimation Storyboard.TargetName="Press" Storyboard.TargetProperty="ScaleY" To="1" Duration="0:0:0.15"/>
                                </Storyboard></BeginStoryboard></Trigger.ExitActions>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.88"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.4"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <!-- No background: the progress ring and the "..." button of an app -->
        <Style x:Key="Bare" TargetType="Button">
            <Setter Property="Foreground" Value="{DynamicResource Text3}"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="Transparent" CornerRadius="14" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Fill}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- macOS style menu (the "..." of an app): no icon column, rounded, accent highlight -->
        <Style x:Key="MacMenu" TargetType="ContextMenu">
            <Setter Property="OverridesDefaultStyle" Value="True"/>
            <Setter Property="SnapsToDevicePixels" Value="True"/>
            <Setter Property="HasDropShadow" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ContextMenu">
                        <Border Background="{DynamicResource Popup}" BorderBrush="{DynamicResource FillHover}" BorderThickness="1" CornerRadius="8" Padding="4">
                            <StackPanel IsItemsHost="True" KeyboardNavigation.DirectionalNavigation="Cycle"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="MacMenuItem" TargetType="MenuItem">
            <Setter Property="OverridesDefaultStyle" Value="True"/>
            <Setter Property="Foreground" Value="{DynamicResource Text2}"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="MenuItem">
                        <Border x:Name="Bd" Background="Transparent" CornerRadius="5" Padding="12,6" MinWidth="160">
                            <ContentPresenter ContentSource="Header" RecognizesAccessKey="True"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsHighlighted" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Accent}"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="MacMenuDanger" TargetType="MenuItem" BasedOn="{StaticResource MacMenuItem}">
            <Setter Property="Foreground" Value="#FF453A"/>
        </Style>

        <!-- One part of a segmented control -->
        <Style x:Key="Segment" TargetType="RadioButton">
            <Setter Property="Foreground" Value="{DynamicResource Text3}"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="Bd" Background="Transparent" CornerRadius="5" Padding="12,3">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource SegmentOn}"/>
                                <Setter Property="Foreground" Value="{DynamicResource Text}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- A small on/off pill (My games: High priority, Dedicated GPU, Skip Defender) -->
        <Style x:Key="Chip" TargetType="CheckBox">
            <Setter Property="Foreground" Value="{DynamicResource Text3}"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <Border x:Name="Bd" Background="{DynamicResource Fill}" CornerRadius="12" Padding="11,4">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Accent}"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.4"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="Action" TargetType="Button">
            <Setter Property="Foreground" Value="{DynamicResource Text2}"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Margin" Value="0,0,0,10"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" RenderTransformOrigin="0.5,0.5" Background="{DynamicResource Field}" BorderBrush="{DynamicResource Line}" BorderThickness="1" CornerRadius="10" Padding="14,12"><Border.RenderTransform><ScaleTransform x:Name="Press"/></Border.RenderTransform>
                            <ContentPresenter HorizontalAlignment="Stretch" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsPressed" Value="True">
                                <Trigger.EnterActions><BeginStoryboard><Storyboard>
                                    <DoubleAnimation Storyboard.TargetName="Press" Storyboard.TargetProperty="ScaleX" To="0.96" Duration="0:0:0.08"/>
                                    <DoubleAnimation Storyboard.TargetName="Press" Storyboard.TargetProperty="ScaleY" To="0.96" Duration="0:0:0.08"/>
                                </Storyboard></BeginStoryboard></Trigger.EnterActions>
                                <Trigger.ExitActions><BeginStoryboard><Storyboard>
                                    <DoubleAnimation Storyboard.TargetName="Press" Storyboard.TargetProperty="ScaleX" To="1" Duration="0:0:0.15"/>
                                    <DoubleAnimation Storyboard.TargetName="Press" Storyboard.TargetProperty="ScaleY" To="1" Duration="0:0:0.15"/>
                                </Storyboard></BeginStoryboard></Trigger.ExitActions>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource Accent}"/>
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Fill}"/>
                                <!-- Grows a little under the mouse -->
                                <Trigger.EnterActions><BeginStoryboard><Storyboard>
                                    <DoubleAnimation Storyboard.TargetName="Press" Storyboard.TargetProperty="ScaleX" To="1.03" Duration="0:0:0.15"/>
                                    <DoubleAnimation Storyboard.TargetName="Press" Storyboard.TargetProperty="ScaleY" To="1.03" Duration="0:0:0.15"/>
                                </Storyboard></BeginStoryboard></Trigger.EnterActions>
                                <Trigger.ExitActions><BeginStoryboard><Storyboard>
                                    <DoubleAnimation Storyboard.TargetName="Press" Storyboard.TargetProperty="ScaleX" To="1" Duration="0:0:0.15"/>
                                    <DoubleAnimation Storyboard.TargetName="Press" Storyboard.TargetProperty="ScaleY" To="1" Duration="0:0:0.15"/>
                                </Storyboard></BeginStoryboard></Trigger.ExitActions>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.5"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Window buttons like macOS: three colored dots, the symbols show when the mouse is over them -->
        <Style x:Key="Light" TargetType="Button">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Margin" Value="0,0,8,0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid Width="14" Height="14" Background="Transparent">
                            <Ellipse x:Name="Dot" Fill="{TemplateBinding Background}" Stroke="#33000000" StrokeThickness="0.5"/>
                            <TextBlock x:Name="Sym" Text="{TemplateBinding Content}" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="7" FontWeight="Bold"
                                       Foreground="#99000000" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Hidden"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <DataTrigger Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=StackPanel}}" Value="True">
                                <Setter TargetName="Sym" Property="Visibility" Value="Visible"/>
                            </DataTrigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Dot" Property="Opacity" Value="0.7"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="Switch" TargetType="CheckBox">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <Border x:Name="Track" Width="40" Height="24" CornerRadius="12" Background="{DynamicResource FillHover}">
                            <Ellipse x:Name="Thumb" Width="20" Height="20" Fill="White" HorizontalAlignment="Left" Margin="2,0">
                                <Ellipse.Effect><DropShadowEffect BlurRadius="3" ShadowDepth="1" Opacity="0.35"/></Ellipse.Effect>
                            </Ellipse>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Track" Property="Background" Value="{DynamicResource Accent}"/>
                                <Setter TargetName="Thumb" Property="HorizontalAlignment" Value="Right"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Track" Property="Opacity" Value="0.45"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="Tick" TargetType="CheckBox">
            <Setter Property="Foreground" Value="{DynamicResource Text2}"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <StackPanel Orientation="Horizontal">
                            <Border x:Name="Box" Width="18" Height="18" CornerRadius="5" Background="{DynamicResource Fill}" BorderBrush="{DynamicResource Handle}" BorderThickness="1" VerticalAlignment="Center">
                                <TextBlock x:Name="Mark" Text="&#xE73E;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="11" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed"/>
                            </Border>
                            <ContentPresenter Margin="10,0,0,0" VerticalAlignment="Center"/>
                        </StackPanel>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Box" Property="Background" Value="{DynamicResource Accent}"/>
                                <Setter TargetName="Box" Property="BorderBrush" Value="{DynamicResource Accent2}"/>
                                <Setter TargetName="Mark" Property="Visibility" Value="Visible"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="Meter" TargetType="ProgressBar">
            <Setter Property="Height" Value="6"/>
            <!-- The bar is painted with Foreground, so code can turn it orange or red -->
            <Setter Property="Foreground" Value="{DynamicResource AccentGradient}"/>
            <Setter Property="Minimum" Value="0"/>
            <Setter Property="Maximum" Value="100"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ProgressBar">
                        <Grid>
                            <Border x:Name="PART_Track" Background="{DynamicResource Line}" CornerRadius="3"/>
                            <Border x:Name="PART_Indicator" Background="{TemplateBinding Foreground}" CornerRadius="3" HorizontalAlignment="Left"/>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="Progress" TargetType="ProgressBar">
            <Setter Property="Height" Value="4"/>
            <Setter Property="Minimum" Value="0"/>
            <Setter Property="Maximum" Value="100"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ProgressBar">
                        <Grid ClipToBounds="True">
                            <Border x:Name="PART_Track" Background="{DynamicResource Line}" CornerRadius="2"/>
                            <Border x:Name="PART_Indicator" Background="{DynamicResource AccentGradient}" CornerRadius="2" HorizontalAlignment="Left"/>
                            <Border x:Name="Pulse" Width="90" Background="{DynamicResource AccentGradient}" CornerRadius="2" HorizontalAlignment="Left" Visibility="Collapsed">
                                <Border.RenderTransform><TranslateTransform X="-90"/></Border.RenderTransform>
                            </Border>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsIndeterminate" Value="True">
                                <Setter TargetName="PART_Indicator" Property="Visibility" Value="Collapsed"/>
                                <Setter TargetName="Pulse" Property="Visibility" Value="Visible"/>
                                <Trigger.EnterActions>
                                    <BeginStoryboard x:Name="PulseRun">
                                        <Storyboard RepeatBehavior="Forever">
                                            <DoubleAnimation Storyboard.TargetName="Pulse" Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.X)" From="-90" To="640" Duration="0:0:1.5"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.EnterActions>
                                <Trigger.ExitActions>
                                    <StopStoryboard BeginStoryboardName="PulseRun"/>
                                </Trigger.ExitActions>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="Badge" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource Fill}"/>
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="Padding" Value="6,1"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <Style x:Key="Swatch" TargetType="RadioButton">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="GroupName" Value="Accent"/>
            <Setter Property="Margin" Value="0,0,12,0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Grid Width="40" Height="40">
                            <Ellipse x:Name="Ring" Stroke="Transparent" StrokeThickness="2"/>
                            <Ellipse Margin="5" Fill="{TemplateBinding Background}"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Ring" Property="Stroke" Value="{DynamicResource Handle}"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Ring" Property="Stroke" Value="{DynamicResource Text}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="ScrollBar">
            <Setter Property="Width" Value="6"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ScrollBar">
                        <Track x:Name="PART_Track" IsDirectionReversed="True">
                            <Track.Thumb>
                                <Thumb>
                                    <Thumb.Template>
                                        <ControlTemplate TargetType="Thumb">
                                            <Border Background="{DynamicResource Handle}" CornerRadius="3"/>
                                        </ControlTemplate>
                                    </Thumb.Template>
                                </Thumb>
                            </Track.Thumb>
                        </Track>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border x:Name="RootBorder" CornerRadius="14" Background="{DynamicResource RootBg}" BorderBrush="{DynamicResource Line}" BorderThickness="1">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="SideColumn" Width="248"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Sidebar -->
            <Border x:Name="Sidebar" Grid.Column="0" Background="{DynamicResource SidebarBg}" CornerRadius="14,0,0,14" BorderBrush="{DynamicResource Line}" BorderThickness="0,0,1,0">
                <DockPanel Margin="14">
                    <StackPanel x:Name="Lights" DockPanel.Dock="Top" Orientation="Horizontal" Margin="4,0,0,14" HorizontalAlignment="Left" Background="Transparent">
                        <Button x:Name="CloseButton" Style="{StaticResource Light}" Background="#FF5F57" Content="&#xE8BB;" ToolTip="Close"/>
                        <Button x:Name="MinButton" Style="{StaticResource Light}" Background="#FEBC2E" Content="&#xE921;" ToolTip="Minimize"/>
                        <Button x:Name="MaxButton" Style="{StaticResource Light}" Background="#28C840" Content="&#xE740;" ToolTip="Full screen"/>
                    </StackPanel>
                    <Border DockPanel.Dock="Top" x:Name="Brand" CornerRadius="12" Height="112" ClipToBounds="True" Margin="0,0,0,18" TextElement.Foreground="White">
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0,1" EndPoint="1,0">
                                <GradientStop Color="#173A72" Offset="0"/>
                                <GradientStop Color="#1A1030" Offset="0.5"/>
                                <GradientStop Color="#4A1C7A" Offset="1"/>
                            </LinearGradientBrush>
                        </Border.Background>
                        <Grid>
                            <Image x:Name="BrandImage" Stretch="UniformToFill" Opacity="0.9"/>
                            <StackPanel VerticalAlignment="Bottom" Margin="16,0,16,14">
                                <StackPanel Orientation="Horizontal">
                                    <Image x:Name="LogoImage" Width="30" Height="30" Margin="0,0,10,0"/>
                                    <TextBlock Text="AKATI OS" FontSize="20" FontWeight="Bold" VerticalAlignment="Center"/>
                                </StackPanel>
                                <TextBlock Text="CENTER" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource Accent2}" Margin="40,0,0,0"/>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <StackPanel x:Name="SideBottom" DockPanel.Dock="Bottom">
                        <Button x:Name="LangButton" Style="{StaticResource Secondary}" Margin="0,0,0,8">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Style="{StaticResource Glyph}" Text="&#xE774;" FontSize="14" Margin="0,0,8,0"/>
                                <TextBlock x:Name="LangLabel" Text="ภาษาไทย"/>
                            </StackPanel>
                        </Button>
                        <Border Background="{DynamicResource Field}" CornerRadius="8" Padding="12,9" BorderBrush="{DynamicResource Line}" BorderThickness="1">
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                <TextBlock Style="{StaticResource Glyph}" Text="&#xE83D;" FontSize="13" Foreground="{DynamicResource Accent2}" Margin="0,0,8,0"/>
                                <TextBlock x:Name="AdminLabel" Tag="t:admin" Text="Administrator mode" FontSize="12" FontWeight="SemiBold"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <!-- Search like macOS Spotlight: opens the search over the window (Ctrl+K) -->
                    <Button x:Name="SpotlightButton" DockPanel.Dock="Top" Cursor="Hand" Margin="0,0,0,12" Tag="t:spot.search" Content="Search">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="Bd" Background="{DynamicResource Field}" BorderBrush="{DynamicResource Line}" BorderThickness="1" CornerRadius="7" Padding="10,6">
                                    <DockPanel>
                                        <TextBlock DockPanel.Dock="Right" Text="Ctrl+K" FontSize="11" Foreground="{DynamicResource MutedBrush}" VerticalAlignment="Center"/>
                                        <TextBlock Style="{StaticResource Glyph}" Text="&#xE721;" FontSize="12" Foreground="{DynamicResource MutedBrush}" Margin="0,0,8,0"/>
                                        <ContentPresenter TextElement.Foreground="{DynamicResource MutedBrush}" TextElement.FontSize="13" VerticalAlignment="Center"/>
                                    </DockPanel>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Bd" Property="Background" Value="{DynamicResource Line}"/></Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>

                    <StackPanel>
                        <RadioButton x:Name="NavDashboard" Style="{StaticResource Nav}" IsChecked="True">
                            <StackPanel Orientation="Horizontal"><Border Style="{StaticResource NavIcon}" Background="#0A84FF"><TextBlock Style="{StaticResource NavGlyph}" Text="&#xE80F;"/></Border><TextBlock Tag="t:nav.dashboard" Text="Dashboard"/></StackPanel>
                        </RadioButton>
                        <RadioButton x:Name="NavGaming" Style="{StaticResource Nav}">
                            <StackPanel Orientation="Horizontal"><Border Style="{StaticResource NavIcon}" Background="#30D158"><TextBlock Style="{StaticResource NavGlyph}" Text="&#xE7FC;"/></Border><TextBlock Tag="t:nav.gaming" Text="Gaming apps"/></StackPanel>
                        </RadioButton>
                        <RadioButton x:Name="NavBoost" Style="{StaticResource Nav}">
                            <StackPanel Orientation="Horizontal"><Border Style="{StaticResource NavIcon}" Background="#FF9F0A"><TextBlock Style="{StaticResource NavGlyph}" Text="&#xE945;"/></Border><TextBlock Tag="t:nav.boost" Text="Game boost"/></StackPanel>
                        </RadioButton>
                        <RadioButton x:Name="NavTweaks" Style="{StaticResource Nav}">
                            <StackPanel Orientation="Horizontal"><Border Style="{StaticResource NavIcon}" Background="#8E8E93"><TextBlock Style="{StaticResource NavGlyph}" Text="&#xE713;"/></Border><TextBlock Tag="t:nav.tweaks" Text="Tweaks"/></StackPanel>
                        </RadioButton>
                        <RadioButton x:Name="NavHealth" Style="{StaticResource Nav}">
                            <StackPanel Orientation="Horizontal"><Border Style="{StaticResource NavIcon}" Background="#FF375F"><TextBlock Style="{StaticResource NavGlyph}" Text="&#xE95E;"/></Border><TextBlock Tag="t:nav.health" Text="Health"/></StackPanel>
                        </RadioButton>
                        <RadioButton x:Name="NavCleaner" Style="{StaticResource Nav}">
                            <StackPanel Orientation="Horizontal"><Border Style="{StaticResource NavIcon}" Background="#FF453A"><TextBlock Style="{StaticResource NavGlyph}" Text="&#xE74D;"/></Border><TextBlock Tag="t:nav.cleaner" Text="Cleaner"/></StackPanel>
                        </RadioButton>
                        <RadioButton x:Name="NavUninstall" Style="{StaticResource Nav}">
                            <StackPanel Orientation="Horizontal"><Border Style="{StaticResource NavIcon}" Background="#FF6482"><TextBlock Style="{StaticResource NavGlyph}" Text="&#xE74C;"/></Border><TextBlock Tag="t:nav.uninstall" Text="Uninstaller"/></StackPanel>
                        </RadioButton>
                        <RadioButton x:Name="NavAppearance" Style="{StaticResource Nav}">
                            <StackPanel Orientation="Horizontal"><Border Style="{StaticResource NavIcon}" Background="#BF5AF2"><TextBlock Style="{StaticResource NavGlyph}" Text="&#xE771;"/></Border><TextBlock Tag="t:nav.appearance" Text="Appearance"/></StackPanel>
                        </RadioButton>
                        <RadioButton x:Name="NavAbout" Style="{StaticResource Nav}">
                            <StackPanel Orientation="Horizontal"><Border Style="{StaticResource NavIcon}" Background="#64D2FF"><TextBlock Style="{StaticResource NavGlyph}" Text="&#xE946;"/></Border><TextBlock Tag="t:nav.about" Text="About"/></StackPanel>
                        </RadioButton>
                    </StackPanel>
                </DockPanel>
            </Border>

            <!-- Main -->
            <Grid Grid.Column="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="48"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="34"/>
                </Grid.RowDefinitions>

                <Grid x:Name="TitleBar" Grid.Row="0" Background="Transparent">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="16,0,0,0">
                        <Button x:Name="SidebarToggle" Style="{StaticResource Bare}" Margin="0,0,10,0" Padding="6,4" VerticalAlignment="Center">
                            <TextBlock Style="{StaticResource Glyph}" Text="&#xE700;" FontSize="14" Foreground="{DynamicResource MutedBrush}"/>
                        </Button>
                        <TextBlock x:Name="PageTitle" Text="Dashboard" FontSize="15" FontWeight="Bold" VerticalAlignment="Center"/>
                    </StackPanel>
                    <!-- Shown when a change needs a restart -->
                    <Border x:Name="RestartBar" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,20,0" Visibility="Collapsed"
                            Background="{DynamicResource Field}" BorderBrush="{DynamicResource Line}" BorderThickness="1" CornerRadius="16" Padding="12,4,4,4">
                        <StackPanel Orientation="Horizontal">
                            <Ellipse Width="7" Height="7" Fill="#FF9F0A" Margin="0,0,8,0" VerticalAlignment="Center"/>
                            <TextBlock Tag="t:restart.bar" Text="Restart to finish the changes" FontSize="12" VerticalAlignment="Center" Margin="0,0,10,0"/>
                            <Button x:Name="RestartNow" Style="{StaticResource PillAccent}" Padding="12,4" Tag="t:restart.now" Content="Restart now"/>
                        </StackPanel>
                    </Border>
                </Grid>

                <Grid Grid.Row="1" Margin="28,0,28,0">

                    <!-- Dashboard -->
                    <ScrollViewer x:Name="PageDashboard" VerticalScrollBarVisibility="Auto">
                        <!-- The cards can be hidden and moved (Customize dashboard): DashPanel children before DashEditBar -->
                        <StackPanel x:Name="DashPanel">
                            <Grid x:Name="DashHero" Margin="0,0,0,12" Height="150">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="16"/>
                                    <ColumnDefinition Width="260"/>
                                </Grid.ColumnDefinitions>
                                <!-- Always dark with white text: it shows the dark Akati OS picture (also in the light look) -->
                                <Border Style="{StaticResource Card}" Padding="0" ClipToBounds="True" Background="#1C1C1E" BorderBrush="#38383A">
                                    <Grid TextElement.Foreground="#F5F5F7">
                                        <Image x:Name="HeroImage" Stretch="UniformToFill" Opacity="0.55"/>
                                        <StackPanel HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,18,22,0">
                                            <TextBlock x:Name="ClockTime" Text="00:00" FontSize="26" FontWeight="Bold" HorizontalAlignment="Right"/>
                                            <TextBlock x:Name="ClockDate" Text="" Foreground="{DynamicResource MutedBrush}" HorizontalAlignment="Right"/>
                                        </StackPanel>
                                        <StackPanel Margin="24,22">
                                            <TextBlock x:Name="Greeting" Text="Welcome back" Foreground="{DynamicResource Accent2}" FontWeight="SemiBold"/>
                                            <TextBlock x:Name="PcName" Text="PC" FontSize="30" FontWeight="Bold" Margin="0,4,0,6"/>
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Style="{StaticResource Glyph}" Text="&#xE7F8;" FontSize="12" Foreground="{DynamicResource MutedBrush}" Margin="0,0,8,0"/>
                                                <TextBlock x:Name="OsLine" Text="Windows" Foreground="{DynamicResource MutedBrush}"/>
                                            </StackPanel>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                                <Border Grid.Column="2" Style="{StaticResource Card}">
                                    <StackPanel>
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Style="{StaticResource Glyph}" Text="&#xE946;" FontSize="13" Foreground="{DynamicResource Accent2}" Margin="0,0,8,0"/>
                                            <TextBlock Tag="t:version" Text="Akati OS version" Style="{StaticResource Label}" VerticalAlignment="Center"/>
                                        </StackPanel>
                                        <TextBlock x:Name="VersionBig" Text="v1.10.0" FontSize="30" FontWeight="Bold" Margin="0,8,0,0"/>
                                        <TextBlock x:Name="EditionText" Text="Windows 11" Style="{StaticResource Muted}"/>
                                        <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                                            <Ellipse x:Name="UpdateDot" Width="7" Height="7" Fill="{DynamicResource MutedBrush}" Margin="0,0,7,0" VerticalAlignment="Center"/>
                                            <TextBlock x:Name="UpdateHint" Tag="t:update.checking" Text="Checking for updates..." Style="{StaticResource Muted}" FontSize="12" TextWrapping="Wrap" MaxWidth="200"/>
                                        </StackPanel>
                                    </StackPanel>
                                </Border>
                            </Grid>

                            <WrapPanel x:Name="StatusChips" Margin="0,0,0,12"/>

                            <Border x:Name="DashSpecs" Style="{StaticResource Card}" Padding="18,12" Margin="0,0,0,16">
                                <WrapPanel x:Name="SpecsPanel">
                                    <StackPanel Orientation="Horizontal" Margin="0,0,28,0"><TextBlock Text="CPU" Style="{StaticResource Label}" Margin="0,0,8,0" VerticalAlignment="Center"/><TextBlock x:Name="CpuName" Text="-" FontWeight="SemiBold"/></StackPanel>
                                    <StackPanel Orientation="Horizontal" Margin="0,0,28,0"><TextBlock Text="GPU" Style="{StaticResource Label}" Margin="0,0,8,0" VerticalAlignment="Center"/><TextBlock x:Name="GpuName" Text="-" FontWeight="SemiBold"/></StackPanel>
                                    <StackPanel Orientation="Horizontal"><TextBlock Text="RAM" Style="{StaticResource Label}" Margin="0,0,8,0" VerticalAlignment="Center"/><TextBlock x:Name="RamName" Text="-" FontWeight="SemiBold"/></StackPanel>
                                </WrapPanel>
                            </Border>

                            <UniformGrid x:Name="UsageGrid" Columns="3" Margin="-8,0,-8,16">
                                <Border Style="{StaticResource Card}" Margin="8,0">
                                    <StackPanel>
                                        <Grid>
                                            <TextBlock Tag="t:cpu" Text="CPU USAGE" Style="{StaticResource Label}" VerticalAlignment="Center"/>
                                            <TextBlock x:Name="CpuValue" Text="0%" FontSize="28" FontWeight="Bold" HorizontalAlignment="Right"/>
                                        </Grid>
                                        <Canvas x:Name="CpuSpark" Height="38" Margin="0,8,0,0" ClipToBounds="True">
                                            <Polygon x:Name="CpuFill" Fill="{DynamicResource Accent2}" Opacity="0.14"/>
                                            <Polyline x:Name="CpuLine" Stroke="{DynamicResource Accent2}" StrokeThickness="1.6" StrokeLineJoin="Round"/>
                                        </Canvas>
                                        <ProgressBar x:Name="CpuBar" Style="{StaticResource Meter}" Margin="0,6,0,0"/>
                                    </StackPanel>
                                </Border>
                                <Border Style="{StaticResource Card}" Margin="8,0">
                                    <StackPanel>
                                        <Grid>
                                            <TextBlock Tag="t:ram" Text="RAM USAGE" Style="{StaticResource Label}" VerticalAlignment="Center"/>
                                            <TextBlock x:Name="RamValue" Text="0%" FontSize="28" FontWeight="Bold" HorizontalAlignment="Right"/>
                                        </Grid>
                                        <Canvas x:Name="RamSpark" Height="38" Margin="0,8,0,0" ClipToBounds="True">
                                            <Polygon x:Name="RamFill" Fill="{DynamicResource Accent2}" Opacity="0.14"/>
                                            <Polyline x:Name="RamLine" Stroke="{DynamicResource Accent2}" StrokeThickness="1.6" StrokeLineJoin="Round"/>
                                        </Canvas>
                                        <ProgressBar x:Name="RamBar" Style="{StaticResource Meter}" Margin="0,6,0,0"/>
                                        <TextBlock x:Name="RamDetail" Text="" Style="{StaticResource Muted}" FontSize="11" Margin="0,8,0,0"/>
                                    </StackPanel>
                                </Border>
                                <Border x:Name="GpuCard" Style="{StaticResource Card}" Margin="8,0">
                                    <StackPanel>
                                        <Grid>
                                            <TextBlock Tag="t:gpu" Text="GPU USAGE" Style="{StaticResource Label}" VerticalAlignment="Center"/>
                                            <TextBlock x:Name="GpuValue" Text="0%" FontSize="28" FontWeight="Bold" HorizontalAlignment="Right"/>
                                        </Grid>
                                        <Canvas x:Name="GpuSpark" Height="38" Margin="0,8,0,0" ClipToBounds="True">
                                            <Polygon x:Name="GpuFill" Fill="{DynamicResource Accent2}" Opacity="0.14"/>
                                            <Polyline x:Name="GpuLine" Stroke="{DynamicResource Accent2}" StrokeThickness="1.6" StrokeLineJoin="Round"/>
                                        </Canvas>
                                        <ProgressBar x:Name="GpuBar" Style="{StaticResource Meter}" Margin="0,6,0,0"/>
                                    </StackPanel>
                                </Border>
                            </UniformGrid>

                            <UniformGrid x:Name="DashStorage" Columns="2" Margin="-8,0,-8,16">
                                <Border Style="{StaticResource Card}" Margin="8,0">
                                    <StackPanel>
                                        <TextBlock Tag="t:disk.title" Text="Storage" Style="{StaticResource CardTitle}" Margin="0,0,0,10"/>
                                        <StackPanel x:Name="DisksPanel"/>
                                    </StackPanel>
                                </Border>
                                <Border Style="{StaticResource Card}" Margin="8,0">
                                    <StackPanel>
                                        <DockPanel Margin="0,0,0,10">
                                            <TextBlock x:Name="NetInfo" DockPanel.Dock="Right" Text="" Style="{StaticResource Muted}" FontSize="12" VerticalAlignment="Center" TextWrapping="NoWrap"/>
                                            <TextBlock Tag="t:net.title" Text="Network" Style="{StaticResource CardTitle}"/>
                                        </DockPanel>
                                        <UniformGrid Columns="3">
                                            <StackPanel><TextBlock Tag="t:net.down" Text="DOWNLOAD" Style="{StaticResource Label}"/><TextBlock x:Name="NetDown" Text="-" FontSize="18" FontWeight="Bold" Margin="0,4,0,0"/></StackPanel>
                                            <StackPanel><TextBlock Tag="t:net.up" Text="UPLOAD" Style="{StaticResource Label}"/><TextBlock x:Name="NetUp" Text="-" FontSize="18" FontWeight="Bold" Margin="0,4,0,0"/></StackPanel>
                                            <StackPanel><TextBlock Tag="t:net.ping" Text="PING (SG)" Style="{StaticResource Label}"/><TextBlock x:Name="NetPing" Text="-" FontSize="18" FontWeight="Bold" Margin="0,4,0,0"/></StackPanel>
                                        </UniformGrid>
                                    </StackPanel>
                                </Border>
                            </UniformGrid>

                            <!-- Busiest apps, by CPU or by memory (segmented control like macOS) -->
                            <StackPanel x:Name="DashTop">
                            <DockPanel Margin="0,0,0,8">
                                <Border DockPanel.Dock="Right" Background="{DynamicResource CardBg}" BorderBrush="{DynamicResource Line}" BorderThickness="1" CornerRadius="7" Padding="2">
                                    <StackPanel Orientation="Horizontal">
                                        <RadioButton x:Name="TopByCpu" Style="{StaticResource Segment}" GroupName="TopBy" IsChecked="True" Content="CPU"/>
                                        <RadioButton x:Name="TopByRam" Style="{StaticResource Segment}" GroupName="TopBy" Tag="t:top.ram" Content="Memory"/>
                                    </StackPanel>
                                </Border>
                                <TextBlock Tag="t:top.title" Text="Busiest apps" Style="{StaticResource Section}" Margin="4,0,0,0" VerticalAlignment="Center"/>
                            </DockPanel>
                            <Border Style="{StaticResource Card}" Padding="0" Margin="0,0,0,16">
                                <StackPanel x:Name="TopList">
                                    <Border Style="{StaticResource Shimmer}" Width="420" HorizontalAlignment="Left"/>
                                    <Border Style="{StaticResource Shimmer}" Width="360" HorizontalAlignment="Left"/>
                                    <Border Style="{StaticResource Shimmer}" Width="300" HorizontalAlignment="Left"/>
                                </StackPanel>
                            </Border>
                            </StackPanel>

                            <!-- This week: what Akati OS did since Monday -->
                            <Border x:Name="DashWeek" Style="{StaticResource Card}" Margin="0,0,0,16">
                                <StackPanel>
                                    <DockPanel Margin="0,0,0,12">
                                        <TextBlock x:Name="WeekRange" DockPanel.Dock="Right" Style="{StaticResource Muted}" FontSize="12" VerticalAlignment="Center"/>
                                        <TextBlock Tag="t:week.title" Text="This week" Style="{StaticResource CardTitle}"/>
                                    </DockPanel>
                                    <UniformGrid Columns="3">
                                        <StackPanel>
                                            <TextBlock Tag="t:week.clean" Text="CLEANED" Style="{StaticResource Label}"/>
                                            <TextBlock x:Name="WeekClean" Text="-" FontSize="22" FontWeight="Bold" Margin="0,4,0,0"/>
                                            <TextBlock x:Name="WeekCleanSub" Style="{StaticResource Muted}" FontSize="11" TextWrapping="Wrap"/>
                                        </StackPanel>
                                        <StackPanel>
                                            <TextBlock Tag="t:week.boost" Text="GAME BOOST" Style="{StaticResource Label}"/>
                                            <TextBlock x:Name="WeekBoost" Text="-" FontSize="22" FontWeight="Bold" Margin="0,4,0,0"/>
                                            <TextBlock x:Name="WeekBoostSub" Style="{StaticResource Muted}" FontSize="11" TextWrapping="Wrap"/>
                                        </StackPanel>
                                        <StackPanel>
                                            <TextBlock Tag="t:week.score" Text="AKATI SCORE" Style="{StaticResource Label}"/>
                                            <TextBlock x:Name="WeekScore" Text="-" FontSize="22" FontWeight="Bold" Margin="0,4,0,0"/>
                                            <TextBlock x:Name="WeekScoreSub" Style="{StaticResource Muted}" FontSize="11" TextWrapping="Wrap"/>
                                        </StackPanel>
                                    </UniformGrid>
                                </StackPanel>
                            </Border>

                            <Border x:Name="DashQuick" Style="{StaticResource Card}" Margin="0,0,0,16">
                                <StackPanel>
                                    <TextBlock Tag="t:quick" Text="Quick actions" Style="{StaticResource CardTitle}" Margin="0,0,0,14"/>
                                    <UniformGrid Columns="4" Margin="-5,0">
                                        <Button x:Name="QuickBoost" Style="{StaticResource Action}" Margin="5,0">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Style="{StaticResource Glyph}" Text="&#xE945;" Foreground="{DynamicResource Accent2}" Margin="0,0,12,0"/>
                                                <StackPanel><TextBlock Tag="t:quick.boost" Text="Game boost" FontWeight="SemiBold"/><TextBlock Tag="t:quick.boost.d" Text="Start before you play" Style="{StaticResource Muted}" FontSize="11"/></StackPanel>
                                            </StackPanel>
                                        </Button>
                                        <Button x:Name="QuickClean" Style="{StaticResource Action}" Margin="5,0">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Style="{StaticResource Glyph}" Text="&#xE74D;" Foreground="{DynamicResource Accent2}" Margin="0,0,12,0"/>
                                                <StackPanel><TextBlock Tag="t:quick.clean" Text="Clean temp files" FontWeight="SemiBold"/><TextBlock Tag="t:quick.clean.d" Text="Free up disk space" Style="{StaticResource Muted}" FontSize="11"/></StackPanel>
                                            </StackPanel>
                                        </Button>
                                        <Button x:Name="QuickUpdate" Style="{StaticResource Action}" Margin="5,0">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Style="{StaticResource Glyph}" Text="&#xE895;" Foreground="{DynamicResource Accent2}" Margin="0,0,12,0"/>
                                                <StackPanel><TextBlock Tag="t:quick.update" Text="Check for updates" FontWeight="SemiBold"/><TextBlock Tag="t:quick.update.d" Text="Compare with GitHub" Style="{StaticResource Muted}" FontSize="11"/></StackPanel>
                                            </StackPanel>
                                        </Button>
                                        <Button x:Name="QuickAtlas" Style="{StaticResource Action}" Margin="5,0">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Style="{StaticResource Glyph}" Text="&#xE713;" Foreground="{DynamicResource Accent2}" Margin="0,0,12,0"/>
                                                <StackPanel><TextBlock Tag="t:quick.system" Text="Tweaks" FontWeight="SemiBold"/><TextBlock Tag="t:quick.system.d" Text="Gaming and Windows settings" Style="{StaticResource Muted}" FontSize="11"/></StackPanel>
                                            </StackPanel>
                                        </Button>
                                    </UniformGrid>
                                </StackPanel>
                            </Border>

                            <!-- Customize dashboard: show or hide each card and change the order -->
                            <DockPanel x:Name="DashEditBar" Margin="0,0,0,16" LastChildFill="False">
                                <Button x:Name="DashEdit" DockPanel.Dock="Right" Style="{StaticResource Pill}">
                                    <StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource Glyph}" Text="&#xE70F;" FontSize="13" Margin="0,0,8,0"/><TextBlock Tag="t:dash.edit" Text="Customize dashboard"/></StackPanel>
                                </Button>
                            </DockPanel>
                            <Border x:Name="DashEditor" Style="{StaticResource Card}" Padding="8" Margin="0,0,0,16" Visibility="Collapsed">
                                <StackPanel>
                                    <DockPanel Margin="10,4,10,8">
                                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                                            <Button x:Name="DashReset" Style="{StaticResource Pill}" Margin="0,0,8,0"><TextBlock Tag="t:dash.reset" Text="Reset"/></Button>
                                            <Button x:Name="DashDone" Style="{StaticResource PillAccent}"><TextBlock Tag="t:dash.done" Text="Done"/></Button>
                                        </StackPanel>
                                        <TextBlock Tag="t:dash.title" Text="Cards on the dashboard" Style="{StaticResource CardTitle}" VerticalAlignment="Center"/>
                                    </DockPanel>
                                    <StackPanel x:Name="DashEditList"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>

                    <!-- Gaming apps -->
                    <ScrollViewer x:Name="PageGaming" VerticalScrollBarVisibility="Auto" Visibility="Collapsed">
                        <StackPanel>
                            <TextBlock Tag="t:gaming.title" Text="Gaming apps" FontSize="24" FontWeight="Bold" Visibility="Collapsed"/>
                            <TextBlock Tag="t:gaming.sub" Text="Akati OS does not install apps during setup. Install them here, from official sources." Style="{StaticResource Muted}" Margin="0,4,0,18"/>
                            <Border Style="{StaticResource Card}" Padding="8" Margin="0,0,0,20">
                                <StackPanel>
                                    <DockPanel Margin="10,4,10,4">
                                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                                            <Button x:Name="CheckUpdatesButton" Style="{StaticResource Pill}" Margin="0,0,8,0">
                                                <StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource Glyph}" Text="&#xE895;" FontSize="13" Margin="0,0,8,0"/><TextBlock Tag="t:apps.check" Text="Check for updates"/></StackPanel>
                                            </Button>
                                            <Button x:Name="UpdateAllButton" Style="{StaticResource Pill}" IsEnabled="False">
                                                <StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource Glyph}" Text="&#xE777;" FontSize="13" Margin="0,0,8,0"/><TextBlock x:Name="UpdateAllText" Text="Update all"/></StackPanel>
                                            </Button>
                                        </StackPanel>
                                        <!-- Starter pack: the two apps most players install first -->
                                        <Button x:Name="StarterButton" DockPanel.Dock="Left" Style="{StaticResource PillAccent}" Margin="0,0,12,0">
                                            <StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource Glyph}" Text="&#xE896;" FontSize="13" Margin="0,0,8,0"/><TextBlock Tag="t:apps.starter" Text="Get Steam and Discord"/></StackPanel>
                                        </Button>
                                        <TextBlock Tag="t:apps.hint" Text="Apps install one after another." Style="{StaticResource Muted}" VerticalAlignment="Center" Margin="0,0,12,0" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"/>
                                    </DockPanel>
                                </StackPanel>
                            </Border>
                            <!-- One section per category, filled by AkatiCenter.ps1 -->
                            <StackPanel x:Name="AppsGroups"/>
                            <TextBlock Tag="t:gpu.title" Text="GPU drivers" Style="{StaticResource Section}"/>
                            <Border Style="{StaticResource Card}" Margin="0,0,0,16">
                                <StackPanel>
                                    <TextBlock Tag="t:gpu.sub" Text="Opens the official driver download page." Style="{StaticResource Muted}" Margin="0,0,0,4"/>
                                    <TextBlock x:Name="GpuDetected" Text="" Foreground="{DynamicResource Accent2}" FontSize="12" Margin="0,0,0,4" TextWrapping="Wrap"/>
                                    <TextBlock x:Name="GpuDriver" Text="" Style="{StaticResource Muted}" FontSize="12" Margin="0,0,0,14"/>
                                    <StackPanel Orientation="Horizontal">
                                        <Button x:Name="GpuNvidia" Style="{StaticResource Pill}" Content="NVIDIA" Margin="0,0,10,0" MinWidth="110"/>
                                        <Button x:Name="GpuAmd" Style="{StaticResource Pill}" Content="AMD" Margin="0,0,10,0" MinWidth="110"/>
                                        <Button x:Name="GpuIntel" Style="{StaticResource Pill}" Content="Intel" MinWidth="110"/>
                                    </StackPanel>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>

                    <!-- Game boost -->
                    <ScrollViewer x:Name="PageBoost" VerticalScrollBarVisibility="Auto" Visibility="Collapsed">
                        <StackPanel>
                            <TextBlock Tag="t:boost.title" Text="Game boost" FontSize="24" FontWeight="Bold" Visibility="Collapsed"/>
                            <TextBlock Tag="t:boost.sub" Text="One click before you play. Everything goes back the way it was when you stop it." Style="{StaticResource Muted}" Margin="0,4,0,18"/>
                            <Border x:Name="BoostCard" Style="{StaticResource Card}" Margin="0,0,0,16">
                                <StackPanel>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <Border x:Name="BoostIcon" Width="52" Height="52" CornerRadius="14" Background="{DynamicResource Fill}" Margin="0,0,16,0">
                                            <TextBlock Style="{StaticResource Glyph}" Text="&#xE945;" FontSize="22" HorizontalAlignment="Center" Foreground="{DynamicResource Accent2}"/>
                                        </Border>
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                            <TextBlock Tag="t:boost.mode" Text="Game Mode" FontSize="17" FontWeight="SemiBold"/>
                                            <TextBlock x:Name="BoostState" Text="Off" Style="{StaticResource Muted}" Margin="0,2,0,0"/>
                                            <TextBlock x:Name="BoostLast" Style="{StaticResource Muted}" FontSize="12" Margin="0,2,0,0" TextWrapping="Wrap" Visibility="Collapsed"/>
                                        </StackPanel>
                                        <Button x:Name="BoostButton" Grid.Column="2" Style="{StaticResource Primary}" MinWidth="150" VerticalAlignment="Center" Content="Start"/>
                                    </Grid>
                                    <Border Height="1" Background="{DynamicResource Line}" Margin="0,16,0,12"/>
                                    <CheckBox x:Name="BoostPower" Style="{StaticResource Tick}" IsChecked="True" Margin="0,4"><TextBlock Tag="t:boost.power" Text="Switch to the highest performance power plan"/></CheckBox>
                                    <DockPanel>
                                        <Button x:Name="BoostAppsEdit" DockPanel.Dock="Right" Style="{StaticResource Pill}" Padding="10,3" FontSize="12" VerticalAlignment="Center" Margin="8,0,0,0"><TextBlock Tag="t:boost.choose" Text="Choose apps"/></Button>
                                        <CheckBox x:Name="BoostApps" Style="{StaticResource Tick}" IsChecked="True" Margin="0,4"><TextBlock x:Name="BoostAppsText" Tag="t:boost.apps" Text="Close background apps" TextWrapping="Wrap"/></CheckBox>
                                    </DockPanel>
                                    <!-- The apps Game boost closes: the usual ones and any app running now -->
                                    <Border x:Name="BoostAppsPanel" Background="{DynamicResource Field}" CornerRadius="8" Padding="12,10,12,6" Margin="26,4,0,6" Visibility="Collapsed">
                                        <StackPanel>
                                            <TextBlock Tag="t:boost.choose.d" Text="Ticked apps are closed when Game boost starts and opened again when it stops. Apps running now are listed too." Style="{StaticResource Muted}" FontSize="12" TextWrapping="Wrap" Margin="0,0,0,8"/>
                                            <WrapPanel x:Name="BoostAppsChips"/>
                                        </StackPanel>
                                    </Border>
                                    <CheckBox x:Name="BoostNotify" Style="{StaticResource Tick}" IsChecked="True" Margin="0,4"><TextBlock Tag="t:boost.notify" Text="Turn off notifications"/></CheckBox>
                                    <CheckBox x:Name="BoostServices" Style="{StaticResource Tick}" IsChecked="True" Margin="0,4"><TextBlock Tag="t:boost.services" Text="Pause background services until the game is closed" TextWrapping="Wrap"/></CheckBox>
                                    <CheckBox x:Name="BoostMemory" Style="{StaticResource Tick}" IsChecked="True" Margin="0,4"><TextBlock Tag="t:boost.memory" Text="Free up standby memory" TextWrapping="Wrap"/></CheckBox>
                                    <Border Height="1" Background="{DynamicResource Line}" Margin="0,10,0,8"/>
                                    <CheckBox x:Name="BoostAuto" Style="{StaticResource Tick}" Margin="0,4"><TextBlock Tag="t:boost.auto" Text="Start Game boost by itself when a game from My games opens" TextWrapping="Wrap"/></CheckBox>
                                    <CheckBox x:Name="BoostSound" Style="{StaticResource Tick}" IsChecked="True" Margin="0,4"><TextBlock Tag="t:boost.sound" Text="Sound and effect when Game boost starts" TextWrapping="Wrap"/></CheckBox>
                                </StackPanel>
                            </Border>
                            <!-- My games: per game settings, added by the user -->
                            <Border Style="{StaticResource Card}" Padding="8" Margin="0,0,0,16">
                                <StackPanel>
                                    <DockPanel Margin="14,8,14,6">
                                        <Button x:Name="GameAddButton" DockPanel.Dock="Right" Style="{StaticResource PillAccent}" VerticalAlignment="Top">
                                            <StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource Glyph}" Text="&#xE710;" FontSize="12" Margin="0,0,8,0"/><TextBlock Tag="t:games.add" Text="Add game"/></StackPanel>
                                        </Button>
                                        <Button x:Name="GameScanButton" DockPanel.Dock="Right" Style="{StaticResource Pill}" VerticalAlignment="Top" Margin="0,0,8,0">
                                            <StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource Glyph}" Text="&#xE721;" FontSize="12" Margin="0,0,8,0"/><TextBlock Tag="t:games.scan" Text="Find my games"/></StackPanel>
                                        </Button>
                                        <StackPanel Margin="0,0,12,0">
                                            <TextBlock Tag="t:games.title" Text="My games" Style="{StaticResource CardTitle}"/>
                                            <TextBlock Tag="t:games.sub" Text="Settings for each game." Style="{StaticResource Muted}" Margin="0,4,0,0"/>
                                        </StackPanel>
                                    </DockPanel>
                                    <!-- Games found in Steam, Epic Games, Riot and Battle.net: tick and add -->
                                    <Border x:Name="GameScanPanel" Background="{DynamicResource Field}" CornerRadius="8" Padding="12,10" Margin="14,4,14,10" Visibility="Collapsed">
                                        <StackPanel>
                                            <DockPanel Margin="0,0,0,6">
                                                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                                                    <Button x:Name="GameScanCancel" Style="{StaticResource Pill}" Padding="12,4" Margin="0,0,8,0"><TextBlock Tag="t:cancel" Text="Cancel"/></Button>
                                                    <Button x:Name="GameScanAdd" Style="{StaticResource PillAccent}" Padding="12,4"><TextBlock Tag="t:games.scan.add" Text="Add selected"/></Button>
                                                </StackPanel>
                                                <TextBlock x:Name="GameScanTitle" Text="" FontWeight="SemiBold" VerticalAlignment="Center" TextWrapping="Wrap"/>
                                            </DockPanel>
                                            <StackPanel x:Name="GameScanList"/>
                                        </StackPanel>
                                    </Border>
                                    <StackPanel x:Name="GamesList"/>
                                    <TextBlock x:Name="GamesEmpty" Tag="t:games.empty" Text="No games added yet." Style="{StaticResource Muted}" Margin="14,8"/>
                                </StackPanel>
                            </Border>
                            <!-- CPU balance and process rules: done by the icon next to the clock (AkatiTray.ps1), set here (AkatiCenter.rules.ps1) -->
                            <Border Style="{StaticResource Card}" Padding="8" Margin="0,0,0,16">
                                <StackPanel Margin="14,8,14,8">
                                    <DockPanel>
                                        <CheckBox x:Name="BalanceOn" DockPanel.Dock="Right" Style="{StaticResource Switch}" VerticalAlignment="Top"/>
                                        <StackPanel Margin="0,0,12,0">
                                            <TextBlock Tag="t:bal.title" Text="CPU balance" Style="{StaticResource CardTitle}"/>
                                            <TextBlock Tag="t:bal.sub" Text="When an app in the background takes too much CPU, it gets a lower priority until it calms down, so the game and the window in front stay smooth. Its own priority comes back by itself." Style="{StaticResource Muted}" Margin="0,4,0,0" TextWrapping="Wrap"/>
                                        </StackPanel>
                                    </DockPanel>
                                    <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                                        <TextBlock Tag="t:bal.limit" Text="Step in above" Style="{StaticResource Muted}" VerticalAlignment="Center" Margin="0,0,10,0"/>
                                        <Border Background="{DynamicResource CardBg}" BorderBrush="{DynamicResource Line}" BorderThickness="1" CornerRadius="7" Padding="2">
                                            <StackPanel Orientation="Horizontal">
                                                <RadioButton x:Name="BalLimit20" Style="{StaticResource Segment}" GroupName="BalLimit" Content="20%"/>
                                                <RadioButton x:Name="BalLimit30" Style="{StaticResource Segment}" GroupName="BalLimit" Content="30%" IsChecked="True"/>
                                                <RadioButton x:Name="BalLimit50" Style="{StaticResource Segment}" GroupName="BalLimit" Content="50%"/>
                                            </StackPanel>
                                        </Border>
                                        <TextBlock Tag="t:bal.limit2" Text="of the whole CPU" Style="{StaticResource Muted}" VerticalAlignment="Center" Margin="10,0,0,0"/>
                                    </StackPanel>
                                    <TextBlock x:Name="BalTray" Tag="t:bal.notray" Text="The icon next to the clock does this: turn it on in Tweaks > System." Foreground="#FF9F0A" TextWrapping="Wrap" Margin="0,8,0,0" Visibility="Collapsed"/>
                                    <TextBlock x:Name="BalLogHead" Tag="t:bal.log" Text="RECENTLY" Style="{StaticResource Label}" Margin="0,12,0,4" Visibility="Collapsed"/>
                                    <StackPanel x:Name="BalLog"/>
                                    <Border Height="1" Background="{DynamicResource Line}" Margin="0,14,0,12"/>
                                    <DockPanel>
                                        <Button x:Name="RuleAdd" DockPanel.Dock="Right" Style="{StaticResource PillAccent}" VerticalAlignment="Top">
                                            <StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource Glyph}" Text="&#xE710;" FontSize="12" Margin="0,0,8,0"/><TextBlock Tag="t:rules.add" Text="Add rule"/></StackPanel>
                                        </Button>
                                        <StackPanel Margin="0,0,12,0">
                                            <TextBlock Tag="t:rules.title" Text="Process rules" Style="{StaticResource CardTitle}"/>
                                            <TextBlock Tag="t:rules.sub" Text="A priority and the processors an app may use, set every time it starts. For apps of this user; apps that run as administrator are left as they are." Style="{StaticResource Muted}" Margin="0,4,0,0" TextWrapping="Wrap"/>
                                        </StackPanel>
                                    </DockPanel>
                                    <Border x:Name="RulePanel" Background="{DynamicResource Field}" CornerRadius="8" Padding="12,10" Margin="0,10,0,4" Visibility="Collapsed">
                                        <StackPanel>
                                            <TextBlock Tag="t:rules.pick" Text="Pick a running app, or type the name of its .exe" FontWeight="SemiBold"/>
                                            <WrapPanel x:Name="RuleApps" Margin="0,8,0,4"/>
                                            <Grid Margin="0,0,0,10">
                                                <TextBox x:Name="RuleName" Background="{DynamicResource CardBg}" Foreground="{DynamicResource Text2}" CaretBrush="{DynamicResource Text2}" BorderBrush="{DynamicResource Line}" Padding="8,6" VerticalContentAlignment="Center"/>
                                                <TextBlock x:Name="RuleNameHint" Tag="t:rules.name" Text="App name, for example chrome" Foreground="{DynamicResource MutedBrush}" Margin="10,0,0,0" VerticalAlignment="Center" IsHitTestVisible="False"/>
                                            </Grid>
                                            <TextBlock Tag="t:rules.prio" Text="PRIORITY" Style="{StaticResource Label}" Margin="0,0,0,4"/>
                                            <Border Background="{DynamicResource CardBg}" BorderBrush="{DynamicResource Line}" BorderThickness="1" CornerRadius="7" Padding="2" HorizontalAlignment="Left">
                                                <WrapPanel>
                                                    <RadioButton x:Name="RulePrioKeep" Style="{StaticResource Segment}" GroupName="RulePrio" Tag="t:rules.prio.keep" Content="Keep" IsChecked="True"/>
                                                    <RadioButton x:Name="RulePrioIdle" Style="{StaticResource Segment}" GroupName="RulePrio" Tag="t:rules.prio.Idle" Content="Low"/>
                                                    <RadioButton x:Name="RulePrioBelowNormal" Style="{StaticResource Segment}" GroupName="RulePrio" Tag="t:rules.prio.BelowNormal" Content="Below normal"/>
                                                    <RadioButton x:Name="RulePrioNormal" Style="{StaticResource Segment}" GroupName="RulePrio" Tag="t:rules.prio.Normal" Content="Normal"/>
                                                    <RadioButton x:Name="RulePrioAboveNormal" Style="{StaticResource Segment}" GroupName="RulePrio" Tag="t:rules.prio.AboveNormal" Content="Above normal"/>
                                                    <RadioButton x:Name="RulePrioHigh" Style="{StaticResource Segment}" GroupName="RulePrio" Tag="t:rules.prio.High" Content="High"/>
                                                </WrapPanel>
                                            </Border>
                                            <TextBlock Tag="t:rules.cpus" Text="PROCESSORS (NONE TICKED: ALL)" Style="{StaticResource Label}" Margin="0,10,0,4"/>
                                            <WrapPanel x:Name="RuleCpus"/>
                                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,6,0,0">
                                                <Button x:Name="RuleCancel" Style="{StaticResource Pill}" Margin="0,0,8,0"><TextBlock Tag="t:cancel" Text="Cancel"/></Button>
                                                <Button x:Name="RuleSave" Style="{StaticResource PillAccent}"><TextBlock Tag="t:rules.save" Text="Save rule"/></Button>
                                            </StackPanel>
                                        </StackPanel>
                                    </Border>
                                    <StackPanel x:Name="RuleList" Margin="0,8,0,0"/>
                                    <TextBlock x:Name="RuleEmpty" Tag="t:rules.empty" Text="No rules yet." Style="{StaticResource Muted}" Margin="0,8,0,0"/>
                                </StackPanel>
                            </Border>
                            <!-- Anti-cheat mode: Memory integrity (HVCI) on for Valorant, off for FiveM -->
                            <Border Style="{StaticResource Card}" Margin="0,0,0,16">
                                <StackPanel>
                                    <TextBlock Tag="t:ac.title" Text="Anti-cheat mode" Style="{StaticResource CardTitle}"/>
                                    <TextBlock Tag="t:ac.sub" Text="Valorant (Vanguard) can ask for Memory integrity on, FiveM needs it off. Pick the game you play next; Windows changes it after a restart." Style="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,4,0,10"/>
                                    <TextBlock x:Name="AcState" Text="-" FontWeight="SemiBold" Margin="0,0,0,10"/>
                                    <WrapPanel>
                                        <Button x:Name="AcValorant" Style="{StaticResource Secondary}" Margin="0,0,10,0" Tag="t:ac.valorant" Content="Valorant mode"/>
                                        <Button x:Name="AcFiveM" Style="{StaticResource Secondary}" Tag="t:ac.fivem" Content="FiveM mode"/>
                                    </WrapPanel>
                                </StackPanel>
                            </Border>
                            <!-- FPS test: PresentMon (Intel) measures the game that runs, to compare with and without Game boost -->
                            <Border Style="{StaticResource Card}" Margin="0,0,0,16">
                                <StackPanel>
                                    <DockPanel>
                                        <Button x:Name="FpsStart" DockPanel.Dock="Right" Style="{StaticResource PillAccent}" Margin="12,0,0,0" Padding="16,6" VerticalAlignment="Top" Tag="t:fps.start" Content="Measure 30 s"/>
                                        <StackPanel>
                                            <TextBlock Tag="t:fps.title" Text="FPS test" Style="{StaticResource CardTitle}"/>
                                            <TextBlock Tag="t:fps.sub" Text="Start a game from My games, play normally, then press Measure. Run it once with Game boost and once without to see the difference." Style="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,4,0,0"/>
                                        </StackPanel>
                                    </DockPanel>
                                    <TextBlock x:Name="FpsState" Text="" Style="{StaticResource Muted}" Margin="0,8,0,0" TextWrapping="Wrap"/>
                                    <StackPanel x:Name="FpsList" Margin="0,6,0,0"/>
                                </StackPanel>
                            </Border>
                            <!-- FiveM: cache, folder, My games and the connection time to a server -->
                            <Border Style="{StaticResource Card}" Margin="0,0,0,16">
                                <StackPanel>
                                    <TextBlock Tag="t:fivem.title" Text="FiveM" Style="{StaticResource CardTitle}"/>
                                    <TextBlock Tag="t:fivem.sub" Text="Clean the cache when servers load slowly or textures break, and check the connection time to your server." Style="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,4,0,10"/>
                                    <TextBlock x:Name="FivemState" Text="-" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,0,0,10"/>
                                    <WrapPanel Margin="0,0,0,12">
                                        <Button x:Name="FivemClear" Style="{StaticResource Secondary}" Margin="0,0,8,8" Tag="t:fivem.clear" Content="Clear cache"/>
                                        <Button x:Name="FivemOpen" Style="{StaticResource Secondary}" Margin="0,0,8,8" Tag="t:fivem.open" Content="Open folder"/>
                                        <Button x:Name="FivemAdd" Style="{StaticResource Secondary}" Margin="0,0,8,8" Tag="t:fivem.add" Content="Add to My games"/>
                                    </WrapPanel>
                                    <DockPanel>
                                        <Button x:Name="FivemPing" DockPanel.Dock="Right" Style="{StaticResource PillAccent}" Margin="8,0,0,0" Padding="16,6" Tag="t:fivem.ping" Content="Test"/>
                                        <Grid>
                                            <TextBox x:Name="FivemServer" Background="{DynamicResource Field}" Foreground="{DynamicResource Text2}" CaretBrush="{DynamicResource Text2}" BorderBrush="{DynamicResource Line}" Padding="8,6" VerticalContentAlignment="Center"/>
                                            <TextBlock x:Name="FivemServerHint" Tag="t:fivem.server" Text="Server IP:port, for example 1.2.3.4:30120" Foreground="{DynamicResource MutedBrush}" Margin="11,0,0,0" VerticalAlignment="Center" IsHitTestVisible="False"/>
                                        </Grid>
                                    </DockPanel>
                                    <TextBlock x:Name="FivemResult" Text="" Style="{StaticResource Muted}" Margin="0,8,0,0" TextWrapping="Wrap"/>
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource Card}" Margin="0,0,0,16">
                                <StackPanel>
                                    <DockPanel>
                                        <Button x:Name="PingButton" DockPanel.Dock="Right" Style="{StaticResource Secondary}" VerticalAlignment="Top">
                                            <StackPanel Orientation="Horizontal"><TextBlock x:Name="PingGlyph" Style="{StaticResource Glyph}" Text="&#xE768;" FontSize="13" Margin="0,0,8,0"/><TextBlock x:Name="PingButtonText" Tag="t:ping.start" Text="Start test"/></StackPanel>
                                        </Button>
                                        <StackPanel>
                                            <TextBlock Tag="t:ping.title" Text="Ping to game servers" Style="{StaticResource CardTitle}"/>
                                            <TextBlock Tag="t:ping.sub" Text="Connection time to cloud data centers where many games host their Asian servers. Lower is better." Style="{StaticResource Muted}" Margin="0,4,12,10"/>
                                        </StackPanel>
                                    </DockPanel>
                                    <StackPanel x:Name="PingList"/>
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource Card}" Padding="8" Margin="0,0,0,16">
                                <StackPanel>
                                    <StackPanel Margin="14,8,14,6">
                                        <TextBlock Tag="t:startup.title" Text="Startup apps" Style="{StaticResource CardTitle}"/>
                                        <TextBlock Tag="t:startup.sub" Text="Apps that start when you sign in. Fewer apps means a faster start and more free RAM for games." Style="{StaticResource Muted}" Margin="0,4,0,0"/>
                                    </StackPanel>
                                    <StackPanel x:Name="StartupList"/>
                                    <TextBlock x:Name="StartupEmpty" Tag="t:startup.empty" Text="No startup apps." Style="{StaticResource Muted}" Margin="14,8" Visibility="Collapsed"/>
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource Card}" Padding="8" Margin="0,0,0,16">
                                <StackPanel>
                                    <StackPanel Margin="14,8,14,6">
                                        <TextBlock Tag="t:bgtasks.title" Text="Background tasks" Style="{StaticResource CardTitle}"/>
                                        <TextBlock Tag="t:bgtasks.sub" Text="Tasks that other apps run on a schedule, mostly their updaters. Turning one off only stops that task; you can turn it on again here." Style="{StaticResource Muted}" Margin="0,4,0,0"/>
                                    </StackPanel>
                                    <StackPanel x:Name="BgTaskList"/>
                                    <TextBlock x:Name="BgTaskEmpty" Tag="t:bgtasks.loading" Text="Reading the tasks..." Style="{StaticResource Muted}" Margin="14,8"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>

                    <!-- Tweaks -->
                    <ScrollViewer x:Name="PageTweaks" VerticalScrollBarVisibility="Auto" Visibility="Collapsed">
                        <StackPanel>
                            <TextBlock Tag="t:tweaks.title" Text="Tweaks" FontSize="24" FontWeight="Bold" Visibility="Collapsed"/>
                            <DockPanel Margin="0,4,0,18">
                                <Button x:Name="TweaksReset" DockPanel.Dock="Right" Style="{StaticResource Pill}" VerticalAlignment="Top" Margin="12,0,0,0">
                                    <StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource Glyph}" Text="&#xE777;" FontSize="12" Margin="0,0,8,0"/><TextBlock Tag="t:tweaks.reset" Text="Reset to Windows defaults"/></StackPanel>
                                </Button>
                                <TextBlock Tag="t:tweaks.sub" Text="Each switch shows the current state of your PC. Turn a tweak off again if games run worse." Style="{StaticResource Muted}"/>
                            </DockPanel>
                            <TextBlock Tag="t:tweaks.gaming" Text="Gaming" Style="{StaticResource Section}"/>
                            <Border Style="{StaticResource Card}" Padding="0" Margin="0,0,0,22">
                                <StackPanel x:Name="TweaksList"/>
                            </Border>
                            <!-- More sections (latency, network, graphics, memory), filled by AkatiCenter.ps1 -->
                            <StackPanel x:Name="TweakGroups"/>
                            <!-- Interrupts: MSI mode, MSI limit, priority and CPU affinity of each PCI device (AkatiCenter.irq.ps1) -->
                            <TextBlock Tag="t:irq.section" Text="Interrupts (advanced)" Style="{StaticResource Section}"/>
                            <Border Style="{StaticResource Card}" Padding="8" Margin="0,0,0,22">
                                <StackPanel>
                                    <DockPanel Margin="14,8,14,6">
                                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Top">
                                            <Border x:Name="IrqHt" Background="{DynamicResource Fill}" CornerRadius="5" Padding="7,2" Margin="0,0,8,0" VerticalAlignment="Center" Visibility="Collapsed">
                                                <TextBlock x:Name="IrqHtText" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource Accent2}"/>
                                            </Border>
                                            <Button x:Name="IrqUndoAll" Style="{StaticResource Pill}" Margin="0,0,8,0" Visibility="Collapsed"><TextBlock Tag="t:irq.undoall" Text="Undo all"/></Button>
                                            <Button x:Name="IrqShow" Style="{StaticResource PillAccent}"><TextBlock x:Name="IrqShowText" Tag="t:irq.show" Text="Show devices"/></Button>
                                        </StackPanel>
                                        <StackPanel Margin="0,0,12,0">
                                            <TextBlock Tag="t:irq.title" Text="MSI mode and CPU affinity" Style="{StaticResource CardTitle}"/>
                                            <TextBlock Tag="t:irq.sub" Text="How each PCI device signals the CPU, and which processors handle it. Windows reads these when the device starts, so a restart is needed after a change." Style="{StaticResource Muted}" Margin="0,4,0,0" TextWrapping="Wrap"/>
                                        </StackPanel>
                                    </DockPanel>
                                    <StackPanel x:Name="IrqPanel" Visibility="Collapsed" Margin="14,4,14,6">
                                        <!-- How to get back when a device stops working -->
                                        <Border Background="#33FF9F0A" BorderBrush="#66FF9F0A" BorderThickness="1" CornerRadius="8" Padding="12,10" Margin="0,0,0,12">
                                            <DockPanel>
                                                <TextBlock Style="{StaticResource Glyph}" Text="&#xE7BA;" Foreground="#FF9F0A" FontSize="16" Margin="0,1,10,0" VerticalAlignment="Top"/>
                                                <StackPanel>
                                                    <TextBlock Tag="t:irq.warn" Text="If a device stops working after the restart" FontWeight="SemiBold"/>
                                                    <TextBlock Tag="t:irq.warn.d" Text="Start Windows in Safe Mode (hold Shift while you click Restart, then Troubleshoot > Advanced options > Startup Settings), open Akati OS Center and press Undo on that device or Undo all. Every device is backed up before its first change." TextWrapping="Wrap" FontSize="12" Margin="0,3,0,0"/>
                                                </StackPanel>
                                            </DockPanel>
                                        </Border>
                                        <!-- Core benchmark: which logical processors get the most work done with the fewest interruptions -->
                                        <Border Background="{DynamicResource Field}" CornerRadius="8" Padding="12,10" Margin="0,0,0,12">
                                            <StackPanel>
                                                <DockPanel>
                                                    <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" VerticalAlignment="Center">
                                                        <Button x:Name="IrqBench" Style="{StaticResource PillAccent}" Margin="0,0,8,0"><TextBlock Tag="t:irq.bench" Text="Benchmark"/></Button>
                                                        <Border Background="{DynamicResource CardBg}" BorderBrush="{DynamicResource Line}" BorderThickness="1" CornerRadius="7" Padding="2" VerticalAlignment="Center">
                                                            <StackPanel Orientation="Horizontal">
                                                                <RadioButton x:Name="IrqRounds3" Style="{StaticResource Segment}" GroupName="IrqRounds" Content="3"/>
                                                                <RadioButton x:Name="IrqRounds5" Style="{StaticResource Segment}" GroupName="IrqRounds" Content="5" IsChecked="True"/>
                                                                <RadioButton x:Name="IrqRounds10" Style="{StaticResource Segment}" GroupName="IrqRounds" Content="10"/>
                                                            </StackPanel>
                                                        </Border>
                                                        <TextBlock Tag="t:irq.rounds" Text="rounds" Style="{StaticResource Muted}" VerticalAlignment="Center" Margin="8,0,14,0"/>
                                                    </StackPanel>
                                                    <TextBlock x:Name="IrqBenchState" Tag="t:irq.bench.ready" Text="Press Benchmark: about half a minute, nothing is changed." VerticalAlignment="Center" TextWrapping="Wrap" FontWeight="SemiBold"/>
                                                </DockPanel>
                                                <TextBlock Tag="t:irq.bench.d" Text="A small piece of work runs on one logical processor at a time, in a new random order each round. CPU 0 is never suggested: Windows uses it for much of its own work." Style="{StaticResource Muted}" FontSize="12" TextWrapping="Wrap" Margin="0,8,0,0"/>
                                                <WrapPanel x:Name="IrqCores" Margin="0,8,0,0"/>
                                            </StackPanel>
                                        </Border>
                                        <TextBlock x:Name="IrqHint" Tag="t:irq.hint" Text="After the benchmark, press Suggested on a device to fill in its settings, then Apply." Style="{StaticResource Muted}" FontSize="12" Margin="2,0,0,6" TextWrapping="Wrap"/>
                                        <StackPanel x:Name="IrqList"/>
                                    </StackPanel>
                                </StackPanel>
                            </Border>
                            <!-- Win32PrioritySeparation: how CPU time is shared between the window in front and the rest (AkatiCenter.priority.ps1) -->
                            <Border Style="{StaticResource Card}" Padding="8" Margin="0,0,0,22">
                                <StackPanel Margin="14,8,14,8">
                                    <DockPanel>
                                        <Button x:Name="W32Measure" DockPanel.Dock="Right" Style="{StaticResource Pill}" VerticalAlignment="Top" Margin="12,0,0,0">
                                            <StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource Glyph}" Text="&#xE916;" FontSize="12" Margin="0,0,8,0"/><TextBlock Tag="t:w32.measure" Text="Measure"/></StackPanel>
                                        </Button>
                                        <StackPanel>
                                            <TextBlock Tag="t:w32.title" Text="CPU time for the window in front" Style="{StaticResource CardTitle}"/>
                                            <TextBlock Tag="t:w32.sub" Text="Win32PrioritySeparation: how Windows shares CPU time between the window in front (your game) and everything else. A new value works at once, no restart." Style="{StaticResource Muted}" Margin="0,4,0,0" TextWrapping="Wrap"/>
                                        </StackPanel>
                                    </DockPanel>
                                    <TextBlock x:Name="W32Now" FontWeight="SemiBold" Margin="0,12,0,0" TextWrapping="Wrap"/>
                                    <TextBlock x:Name="W32Desc" Style="{StaticResource Muted}" FontSize="12" TextWrapping="Wrap" Margin="0,2,0,10"/>
                                    <WrapPanel x:Name="W32Values"/>
                                    <TextBlock x:Name="W32MeasureText" TextWrapping="Wrap" Margin="0,6,0,0" Visibility="Collapsed"/>
                                    <Border Height="1" Background="{DynamicResource Line}" Margin="0,14,0,12"/>
                                    <TextBlock Tag="t:w32.compare" Text="Compare values on this PC" FontWeight="SemiBold"/>
                                    <TextBlock Tag="t:w32.compare.d" Text="A busy program in the background shares one processor with this window. For each value, in a new random order each round, it measures how much of the processor this window gets and how fast its thread wakes up. Your value is put back at the end. Keep this window in front while it runs." Style="{StaticResource Muted}" FontSize="12" TextWrapping="Wrap" Margin="0,2,0,8"/>
                                    <WrapPanel x:Name="W32Pick"/>
                                    <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                        <Border Background="{DynamicResource CardBg}" BorderBrush="{DynamicResource Line}" BorderThickness="1" CornerRadius="7" Padding="2" VerticalAlignment="Center">
                                            <StackPanel Orientation="Horizontal">
                                                <RadioButton x:Name="W32Rounds3" Style="{StaticResource Segment}" GroupName="W32Rounds" Content="3" IsChecked="True"/>
                                                <RadioButton x:Name="W32Rounds6" Style="{StaticResource Segment}" GroupName="W32Rounds" Content="6"/>
                                            </StackPanel>
                                        </Border>
                                        <TextBlock Tag="t:irq.rounds" Text="rounds" Style="{StaticResource Muted}" VerticalAlignment="Center" Margin="8,0,12,0"/>
                                        <Button x:Name="W32Run" Style="{StaticResource PillAccent}" VerticalAlignment="Center"><TextBlock Tag="t:w32.run" Text="Run comparison"/></Button>
                                        <TextBlock x:Name="W32State" Style="{StaticResource Muted}" VerticalAlignment="Center" Margin="12,0,0,0" TextWrapping="Wrap"/>
                                    </StackPanel>
                                    <StackPanel x:Name="W32Results" Margin="0,10,0,0"/>
                                </StackPanel>
                            </Border>
                            <TextBlock Tag="t:tweaks.system" Text="System" Style="{StaticResource Section}"/>
                            <TextBlock Tag="t:system.sub" Text="All Windows settings of Akati OS. A button applies that option; scripts open in a window that explains what they change." Style="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,4,0,14"/>
                            <Border Style="{StaticResource Card}" Padding="14,10" Margin="0,0,0,16">
                                <DockPanel>
                                    <TextBlock Style="{StaticResource Glyph}" Text="&#xE721;" Foreground="{DynamicResource MutedBrush}" Margin="0,0,12,0" VerticalAlignment="Center"/>
                                    <Grid>
                                        <TextBlock x:Name="SystemSearchHint" Tag="t:system.search" Text="Search settings" Foreground="{DynamicResource MutedBrush}" FontSize="14" VerticalAlignment="Center" IsHitTestVisible="False"/>
                                        <TextBox x:Name="SystemSearch" Background="Transparent" BorderThickness="0" Foreground="{DynamicResource Text}" CaretBrush="{DynamicResource Text}" FontSize="14" VerticalContentAlignment="Center"/>
                                    </Grid>
                                </DockPanel>
                            </Border>
                            <Border Style="{StaticResource Card}" Padding="14,12" Margin="0,0,0,16">
                                <DockPanel>
                                    <CheckBox x:Name="RestoreToggle" DockPanel.Dock="Right" Style="{StaticResource Switch}" IsChecked="True" Margin="12,0,0,0"/>
                                    <Button x:Name="RestoreOpen" DockPanel.Dock="Right" Style="{StaticResource Secondary}" VerticalAlignment="Center">
                                        <StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource Glyph}" Text="&#xE777;" FontSize="13" Margin="0,0,8,0"/><TextBlock Tag="t:restore.open" Text="System Restore"/></StackPanel>
                                    </Button>
                                    <TextBlock Style="{StaticResource Glyph}" Text="&#xE81C;" Foreground="{DynamicResource Accent2}" Margin="0,0,14,0"/>
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Tag="t:restore.title" Text="Create a restore point first" FontWeight="SemiBold"/>
                                        <TextBlock x:Name="RestoreSub" Tag="t:restore.sub" Text="Before the first change in this window. Needs System Restore turned on." Style="{StaticResource Muted}" FontSize="12" Margin="0,2,12,0"/>
                                    </StackPanel>
                                </DockPanel>
                            </Border>
                            <StackPanel x:Name="SystemList"/>
                        </StackPanel>
                    </ScrollViewer>

                    <!-- Health: Akati Doctor, startup time and temperatures, crashes, Windows Update, change history, backup -->
                    <ScrollViewer x:Name="PageHealth" VerticalScrollBarVisibility="Auto" Visibility="Collapsed">
                        <StackPanel>
                            <!-- Akati Score: how ready the PC is for games, with what would raise it -->
                            <Border Style="{StaticResource Card}" Margin="0,4,0,8">
                                <Grid>
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                    <StackPanel Margin="4,0,28,0" VerticalAlignment="Center" MinWidth="110">
                                        <TextBlock x:Name="ScoreValue" Text="-" FontSize="46" FontWeight="Bold" HorizontalAlignment="Center"/>
                                        <TextBlock Text="Akati Score" Style="{StaticResource Muted}" HorizontalAlignment="Center"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <TextBlock x:Name="ScoreTitle" Text="" FontWeight="SemiBold" FontSize="15" TextWrapping="Wrap"/>
                                        <StackPanel x:Name="ScoreTips" Margin="0,6,0,0"/>
                                        <!-- The score of each day (the last one of the day), up to 30 days -->
                                        <StackPanel x:Name="ScoreChartBox" Margin="0,12,0,0" Visibility="Collapsed">
                                            <DockPanel>
                                                <TextBlock x:Name="ScoreChartRange" DockPanel.Dock="Right" Style="{StaticResource Label}"/>
                                                <TextBlock Tag="t:score.history" Text="SCORE, LAST 30 DAYS" Style="{StaticResource Label}"/>
                                            </DockPanel>
                                            <Canvas x:Name="ScoreChart" Height="44" Margin="0,6,0,0" ClipToBounds="True">
                                                <Polygon x:Name="ScoreFill" Fill="{DynamicResource Accent2}" Opacity="0.14"/>
                                                <Polyline x:Name="ScoreLine" Stroke="{DynamicResource Accent2}" StrokeThickness="1.6" StrokeLineJoin="Round"/>
                                            </Canvas>
                                        </StackPanel>
                                    </StackPanel>
                                </Grid>
                            </Border>
                            <DockPanel Margin="0,4,0,18">
                                <Button x:Name="DoctorRun" DockPanel.Dock="Right" Style="{StaticResource Pill}" VerticalAlignment="Top" Margin="12,0,0,0">
                                    <StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource Glyph}" Text="&#xE72C;" FontSize="12" Margin="0,0,8,0"/><TextBlock Tag="t:doc.run" Text="Check again"/></StackPanel>
                                </Button>
                                <Button x:Name="ScoreShare" DockPanel.Dock="Right" Style="{StaticResource Pill}" VerticalAlignment="Top" Margin="12,0,0,0">
                                    <StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource Glyph}" Text="&#xE72D;" FontSize="12" Margin="0,0,8,0"/><TextBlock Tag="t:score.share" Text="Share score"/></StackPanel>
                                </Button>
                                <TextBlock x:Name="DoctorSummary" Text="-" Style="{StaticResource Muted}" TextWrapping="Wrap"/>
                            </DockPanel>
                            <TextBlock Tag="t:doc.title" Text="Akati Doctor" Style="{StaticResource Section}"/>
                            <Border Style="{StaticResource Card}" Padding="0" Margin="0,0,0,22">
                                <StackPanel x:Name="DoctorList"/>
                            </Border>
                            <TextBlock Tag="t:health.speed" Text="Startup and temperatures" Style="{StaticResource Section}"/>
                            <Border Style="{StaticResource Card}" Margin="0,0,0,22">
                                <StackPanel>
                                    <TextBlock x:Name="BootTime" Text="-" FontSize="22" FontWeight="Bold"/>
                                    <TextBlock x:Name="BootDetail" Text="" Style="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,4,0,0"/>
                                    <Button x:Name="BootLogOn" Style="{StaticResource Secondary}" HorizontalAlignment="Left" Margin="0,10,0,0" Tag="t:boot.enable" Content="Record the startup time" Visibility="Collapsed"/>
                                    <TextBlock x:Name="TempDetail" Text="" Style="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,8,0,0"/>
                                </StackPanel>
                            </Border>
                            <DockPanel>
                                <Button x:Name="MinidumpOpen" DockPanel.Dock="Right" Style="{StaticResource Pill}" VerticalAlignment="Bottom" Margin="0,0,0,8" Padding="10,3" Tag="t:crash.folder" Content="Crash dump folder" Visibility="Collapsed"/>
                                <TextBlock Tag="t:crash.title" Text="Crashes in the last 30 days" Style="{StaticResource Section}"/>
                            </DockPanel>
                            <Border Style="{StaticResource Card}" Padding="0" Margin="0,0,0,22">
                                <StackPanel>
                                    <TextBlock x:Name="CrashEmpty" Tag="t:crash.none" Text="No crashes. Nice." Style="{StaticResource Muted}" Margin="14,12"/>
                                    <StackPanel x:Name="CrashList"/>
                                </StackPanel>
                            </Border>
                            <TextBlock Tag="t:wu.title" Text="Windows Update" Style="{StaticResource Section}"/>
                            <Border Style="{StaticResource Card}" Margin="0,0,0,22">
                                <StackPanel>
                                    <TextBlock x:Name="WuState" Text="-" FontWeight="SemiBold"/>
                                    <TextBlock Tag="t:wu.sub" Text="Pause updates before a tournament or a long gaming night. Updates come again when the pause ends." Style="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,4,0,12"/>
                                    <WrapPanel>
                                        <Button x:Name="WuPause7" Style="{StaticResource Secondary}" Margin="0,0,10,10" Tag="t:wu.pause7" Content="Pause 1 week"/>
                                        <Button x:Name="WuPause35" Style="{StaticResource Secondary}" Margin="0,0,10,10" Tag="t:wu.pause35" Content="Pause 5 weeks"/>
                                        <Button x:Name="WuResume" Style="{StaticResource Secondary}" Margin="0,0,10,10" Tag="t:wu.resume" Content="Resume updates"/>
                                        <Button x:Name="WuOpen" Style="{StaticResource Secondary}" Margin="0,0,10,10" Tag="t:wu.open" Content="Open Windows Update"/>
                                    </WrapPanel>
                                </StackPanel>
                            </Border>
                            <DockPanel>
                                <Button x:Name="HistoryClear" DockPanel.Dock="Right" Style="{StaticResource Pill}" VerticalAlignment="Bottom" Margin="0,0,0,8" Padding="10,3" Tag="t:history.clear" Content="Clear"/>
                                <TextBlock Tag="t:history.title" Text="Change history" Style="{StaticResource Section}"/>
                            </DockPanel>
                            <Border Style="{StaticResource Card}" Padding="0" Margin="0,0,0,22">
                                <StackPanel>
                                    <TextBlock x:Name="HistoryEmpty" Tag="t:history.none" Text="Switches you change in Tweaks show here, with Undo." Style="{StaticResource Muted}" Margin="14,12" TextWrapping="Wrap"/>
                                    <StackPanel x:Name="HistoryList"/>
                                </StackPanel>
                            </Border>
                            <TextBlock Tag="t:backup.title" Text="Backup" Style="{StaticResource Section}"/>
                            <Border Style="{StaticResource Card}" Margin="0,0,0,16">
                                <DockPanel>
                                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                                        <Button x:Name="BackupSave" Style="{StaticResource Secondary}" Margin="0,0,8,0" Tag="t:backup.save" Content="Save backup"/>
                                        <Button x:Name="BackupLoad" Style="{StaticResource Primary}" Tag="t:backup.load" Content="Restore"/>
                                    </StackPanel>
                                    <TextBlock Tag="t:backup.sub" Text="Save your settings, My games and every switch to a file." Style="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,0,16,0" VerticalAlignment="Center"/>
                                </DockPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>

                    <!-- Cleaner -->
                    <!-- Uninstaller: every installed program and Store app; leftovers after an uninstall (AkatiCenter.uninstall.ps1) -->
                    <ScrollViewer x:Name="PageUninstall" VerticalScrollBarVisibility="Auto" Visibility="Collapsed">
                        <StackPanel>
                            <TextBlock Tag="t:uninst.sub" Text="The programs and Store apps on this PC. Uninstall runs the program's own uninstaller, then looks for the folders, shortcuts and registry keys it left behind. Nothing is removed before you see the list: files go to the Recycle Bin and registry keys are saved as .reg files first." Style="{StaticResource Muted}" Margin="0,4,0,14" TextWrapping="Wrap"/>
                            <DockPanel Margin="0,0,0,10">
                                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center" Margin="12,0,0,0">
                                    <TextBlock x:Name="UninstCount" Style="{StaticResource Muted}" VerticalAlignment="Center" Margin="0,0,10,0"/>
                                    <Button x:Name="UninstRefresh" Style="{StaticResource Pill}" Padding="9,5" ToolTip="Refresh"><TextBlock Style="{StaticResource Glyph}" Text="&#xE72C;" FontSize="12"/></Button>
                                </StackPanel>
                                <Grid>
                                    <TextBox x:Name="UninstSearch" Background="{DynamicResource Field}" Foreground="{DynamicResource Text2}" CaretBrush="{DynamicResource Text2}" BorderBrush="{DynamicResource Line}" Padding="32,7,8,7" VerticalContentAlignment="Center"/>
                                    <TextBlock Style="{StaticResource Glyph}" Text="&#xE721;" FontSize="13" Foreground="{DynamicResource MutedBrush}" Margin="11,0,0,0" VerticalAlignment="Center" IsHitTestVisible="False"/>
                                    <TextBlock x:Name="UninstSearchHint" Tag="t:uninst.search" Text="Search programs or publishers" Foreground="{DynamicResource MutedBrush}" Margin="33,0,0,0" VerticalAlignment="Center" IsHitTestVisible="False"/>
                                </Grid>
                            </DockPanel>
                            <DockPanel Margin="0,0,0,12">
                                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                                    <CheckBox x:Name="UninstQuiet" Style="{StaticResource Tick}" VerticalAlignment="Center" Margin="0,0,14,0"><TextBlock Tag="t:uninst.quiet" Text="Quiet uninstall when possible"/></CheckBox>
                                    <Border Background="{DynamicResource CardBg}" BorderBrush="{DynamicResource Line}" BorderThickness="1" CornerRadius="7" Padding="2">
                                        <StackPanel Orientation="Horizontal">
                                            <RadioButton x:Name="UninstSortName" Style="{StaticResource Segment}" GroupName="UninstSort" Tag="t:uninst.sort.name" Content="Name" IsChecked="True"/>
                                            <RadioButton x:Name="UninstSortSize" Style="{StaticResource Segment}" GroupName="UninstSort" Tag="t:uninst.sort.size" Content="Size"/>
                                            <RadioButton x:Name="UninstSortDate" Style="{StaticResource Segment}" GroupName="UninstSort" Tag="t:uninst.sort.date" Content="Date"/>
                                        </StackPanel>
                                    </Border>
                                </StackPanel>
                                <Border Background="{DynamicResource CardBg}" BorderBrush="{DynamicResource Line}" BorderThickness="1" CornerRadius="7" Padding="2" HorizontalAlignment="Left">
                                    <StackPanel Orientation="Horizontal">
                                        <RadioButton x:Name="UninstShowAll" Style="{StaticResource Segment}" GroupName="UninstShow" Content="All" IsChecked="True"/>
                                        <RadioButton x:Name="UninstShowPrograms" Style="{StaticResource Segment}" GroupName="UninstShow" Content="Programs"/>
                                        <RadioButton x:Name="UninstShowStore" Style="{StaticResource Segment}" GroupName="UninstShow" Content="Store apps"/>
                                    </StackPanel>
                                </Border>
                            </DockPanel>
                            <!-- After an uninstall: what the program left behind, ticked, removed only when asked -->
                            <Border x:Name="UninstLeft" Style="{StaticResource Card}" Margin="0,0,0,14" Visibility="Collapsed" BorderBrush="{DynamicResource Accent2}">
                                <StackPanel>
                                    <DockPanel Margin="0,0,0,8">
                                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Top">
                                            <Button x:Name="UninstLeftKeep" Style="{StaticResource Pill}" Margin="0,0,8,0"><TextBlock Tag="t:uninst.left.keep" Text="Keep them"/></Button>
                                            <Button x:Name="UninstLeftRemove" Style="{StaticResource PillAccent}"><TextBlock Tag="t:uninst.left.remove" Text="Remove selected"/></Button>
                                        </StackPanel>
                                        <StackPanel Margin="0,0,12,0">
                                            <TextBlock x:Name="UninstLeftTitle" Style="{StaticResource CardTitle}" TextWrapping="Wrap"/>
                                            <TextBlock Tag="t:uninst.left.d" Text="Folders and shortcuts go to the Recycle Bin; registry keys are saved as .reg files in ProgramData\AkatiOS\Backups before they are removed." Style="{StaticResource Muted}" FontSize="12" TextWrapping="Wrap" Margin="0,4,0,0"/>
                                        </StackPanel>
                                    </DockPanel>
                                    <StackPanel x:Name="UninstLeftList"/>
                                </StackPanel>
                            </Border>
                            <DockPanel x:Name="UninstBatch" Margin="0,0,0,10" Visibility="Collapsed">
                                <Button x:Name="UninstSelected" DockPanel.Dock="Right" Style="{StaticResource PillAccent}"><TextBlock x:Name="UninstSelectedText" Text=""/></Button>
                                <TextBlock Tag="t:uninst.batch.d" Text="The ticked programs are uninstalled one after another." Style="{StaticResource Muted}" VerticalAlignment="Center"/>
                            </DockPanel>
                            <Border Style="{StaticResource Card}" Padding="0" Margin="0,0,0,16">
                                <StackPanel>
                                    <StackPanel x:Name="UninstList"/>
                                    <TextBlock x:Name="UninstEmpty" Tag="t:uninst.loading" Text="Reading the programs..." Style="{StaticResource Muted}" Margin="16,12"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>

                    <ScrollViewer x:Name="PageCleaner" VerticalScrollBarVisibility="Auto" Visibility="Collapsed">
                        <StackPanel>
                            <TextBlock Tag="t:cleaner.title" Text="Cleaner" FontSize="24" FontWeight="Bold" Visibility="Collapsed"/>
                            <TextBlock Tag="t:cleaner.sub" Text="Deletes temporary files. Files that are in use are skipped." Style="{StaticResource Muted}" Margin="0,4,0,18"/>
                            <Border Style="{StaticResource Card}" Margin="0,0,0,16">
                                <StackPanel>
                                    <StackPanel x:Name="CleanList"/>
                                    <Border Height="1" Background="{DynamicResource Line}" Margin="0,8,0,16"/>
                                    <Grid>
                                        <StackPanel VerticalAlignment="Center">
                                            <TextBlock Tag="t:cleaner.total" Text="Selected" Style="{StaticResource Label}"/>
                                            <TextBlock x:Name="CleanTotal" Text="-" FontSize="22" FontWeight="Bold"/>
                                        </StackPanel>
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                            <Button x:Name="ScanButton" Style="{StaticResource Secondary}" Margin="0,0,10,0">
                                                <StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource Glyph}" Text="&#xE72C;" FontSize="13" Margin="0,0,8,0"/><TextBlock Tag="t:cleaner.scan" Text="Scan"/></StackPanel>
                                            </Button>
                                            <Button x:Name="CleanButton" Style="{StaticResource Primary}">
                                                <StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource Glyph}" Text="&#xE74D;" FontSize="13" Margin="0,0,8,0"/><TextBlock Tag="t:cleaner.clean" Text="Clean now"/></StackPanel>
                                            </Button>
                                        </StackPanel>
                                    </Grid>
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource Card}" Padding="14,12" Margin="0,0,0,16">
                                <DockPanel>
                                    <CheckBox x:Name="AutoCleanToggle" DockPanel.Dock="Right" Style="{StaticResource Switch}" Margin="12,0,0,0" VerticalAlignment="Center"/>
                                    <TextBlock Style="{StaticResource Glyph}" Text="&#xE787;" Foreground="{DynamicResource Accent2}" Margin="0,0,14,0" VerticalAlignment="Center"/>
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Tag="t:autoclean.title" Text="Clean automatically every week" FontWeight="SemiBold"/>
                                        <TextBlock x:Name="AutoCleanSub" Tag="t:autoclean.sub" Text="Sundays at 12:00 (or when the PC is on next). The items ticked by default; not the browser caches or the Recycle Bin." Style="{StaticResource Muted}" FontSize="12" Margin="0,2,12,0" TextWrapping="Wrap"/>
                                    </StackPanel>
                                </DockPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>

                    <!-- Appearance -->
                    <ScrollViewer x:Name="PageAppearance" VerticalScrollBarVisibility="Auto" Visibility="Collapsed">
                        <StackPanel>
                            <TextBlock Tag="t:appearance.title" Text="Appearance" FontSize="24" FontWeight="Bold" Visibility="Collapsed"/>
                            <TextBlock Tag="t:appearance.sub" Text="Pick an Akati OS theme. Windows applies it right away." Style="{StaticResource Muted}" Margin="0,4,0,18"/>
                            <UniformGrid x:Name="ThemesGrid" Columns="3" Margin="-8,0,-8,16"/>
                            <!-- Presets: wallpaper, accent color, look, cursor and sounds in one click -->
                            <Border Style="{StaticResource Card}" Margin="0,0,0,16">
                                <StackPanel>
                                    <TextBlock Tag="t:preset.title" Text="Style presets" Style="{StaticResource CardTitle}"/>
                                    <TextBlock Tag="t:preset.sub" Text="Wallpaper, accent color, Akati OS Center look, cursor and sounds in one click." Style="{StaticResource Muted}" Margin="0,4,0,12"/>
                                    <WrapPanel x:Name="PresetPanel" Margin="0,0,-12,0"/>
                                </StackPanel>
                            </Border>
                            <!-- The look of Akati OS Center itself: like Windows, dark or light -->
                            <Border Style="{StaticResource Card}" Margin="0,0,0,16">
                                <DockPanel>
                                    <Border DockPanel.Dock="Right" Background="{DynamicResource Field}" BorderBrush="{DynamicResource Line}" BorderThickness="1" CornerRadius="7" Padding="2" VerticalAlignment="Center">
                                        <StackPanel Orientation="Horizontal">
                                            <RadioButton x:Name="LookAuto" Style="{StaticResource Segment}" GroupName="CenterLook" Tag="t:look.auto" Content="Auto"/>
                                            <RadioButton x:Name="LookDark" Style="{StaticResource Segment}" GroupName="CenterLook" Tag="t:look.dark" Content="Dark"/>
                                            <RadioButton x:Name="LookLight" Style="{StaticResource Segment}" GroupName="CenterLook" Tag="t:look.light" Content="Light"/>
                                            <RadioButton x:Name="LookTime" Style="{StaticResource Segment}" GroupName="CenterLook" Tag="t:look.time" Content="By time"/>
                                        </StackPanel>
                                    </Border>
                                    <StackPanel Margin="0,0,12,0">
                                        <TextBlock Tag="t:look.title" Text="Akati OS Center look" Style="{StaticResource CardTitle}"/>
                                        <TextBlock Tag="t:look.sub" Text="Auto follows the Windows app mode." Style="{StaticResource Muted}" Margin="0,4,0,0"/>
                                    </StackPanel>
                                </DockPanel>
                            </Border>
                            <!-- Size of everything in the window (Ctrl + and Ctrl - too) -->
                            <Border Style="{StaticResource Card}" Margin="0,0,0,16">
                                <DockPanel>
                                    <Border DockPanel.Dock="Right" Background="{DynamicResource Field}" BorderBrush="{DynamicResource Line}" BorderThickness="1" CornerRadius="7" Padding="2" VerticalAlignment="Center">
                                        <StackPanel Orientation="Horizontal">
                                            <RadioButton x:Name="Zoom90" Style="{StaticResource Segment}" GroupName="CenterZoom" Content="90%"/>
                                            <RadioButton x:Name="Zoom100" Style="{StaticResource Segment}" GroupName="CenterZoom" Content="100%"/>
                                            <RadioButton x:Name="Zoom110" Style="{StaticResource Segment}" GroupName="CenterZoom" Content="110%"/>
                                            <RadioButton x:Name="Zoom125" Style="{StaticResource Segment}" GroupName="CenterZoom" Content="125%"/>
                                        </StackPanel>
                                    </Border>
                                    <StackPanel Margin="0,0,12,0">
                                        <TextBlock Tag="t:zoom.title" Text="Text size" Style="{StaticResource CardTitle}"/>
                                        <TextBlock Tag="t:zoom.sub" Text="Makes everything in Akati OS Center bigger or smaller. Ctrl + and Ctrl - work too." Style="{StaticResource Muted}" Margin="0,4,0,0" TextWrapping="Wrap"/>
                                    </StackPanel>
                                </DockPanel>
                            </Border>
                            <Border Style="{StaticResource Card}" Margin="0,0,0,16">
                                <StackPanel>
                                    <TextBlock Tag="t:accent.title" Text="Accent color" Style="{StaticResource CardTitle}"/>
                                    <TextBlock Tag="t:accent.sub" Text="Used by Akati OS Center, the Windows accent color and the Akati OS Terminal colors." Style="{StaticResource Muted}" Margin="0,4,0,12"/>
                                    <WrapPanel x:Name="AccentPanel"/>
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource Card}" Margin="0,0,0,16">
                                <StackPanel>
                                    <TextBlock Tag="t:wall.title" Text="Wallpapers" Style="{StaticResource CardTitle}"/>
                                    <TextBlock Tag="t:wall.sub" Text="Click a picture to use it as your desktop background." Style="{StaticResource Muted}" Margin="0,4,0,12"/>
                                    <WrapPanel x:Name="WallPanel" Margin="0,0,-12,0"/>
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource Card}" Margin="0,0,0,16">
                                <StackPanel>
                                    <TextBlock Tag="t:style.title" Text="Cursor and sounds" Style="{StaticResource CardTitle}"/>
                                    <TextBlock Tag="t:style.sub" Text="Akati OS pointer and system sounds. Go back to the Windows ones at any time." Style="{StaticResource Muted}" Margin="0,4,0,12"/>
                                    <Grid Margin="0,0,0,10">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="150"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                        <TextBlock Tag="t:style.cursor" Text="Cursor" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                        <WrapPanel Grid.Column="1">
                                            <Button x:Name="CursorAkati" Style="{StaticResource Secondary}" Margin="0,0,8,0" Tag="t:style.akati" Content="Akati OS"/>
                                            <Button x:Name="CursorWindows" Style="{StaticResource Secondary}" Tag="t:style.windows" Content="Windows"/>
                                        </WrapPanel>
                                    </Grid>
                                    <Grid>
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="150"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                        <TextBlock Tag="t:style.sounds" Text="Sounds" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                        <WrapPanel Grid.Column="1">
                                            <Button x:Name="SoundAkati" Style="{StaticResource Secondary}" Margin="0,0,8,0" Tag="t:style.akati" Content="Akati OS"/>
                                            <Button x:Name="SoundWindows" Style="{StaticResource Secondary}" Margin="0,0,8,0" Tag="t:style.windows" Content="Windows"/>
                                            <Button x:Name="SoundNone" Style="{StaticResource Secondary}" Margin="0,0,8,0" Tag="t:style.nosound" Content="No sounds"/>
                                            <Button x:Name="SoundPreview" Style="{StaticResource Secondary}">
                                                <StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource Glyph}" Text="&#xE767;" FontSize="13" Margin="0,0,8,0"/><TextBlock Tag="t:style.preview" Text="Play"/></StackPanel>
                                            </Button>
                                        </WrapPanel>
                                    </Grid>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>

                    <!-- About -->
                    <ScrollViewer x:Name="PageAbout" VerticalScrollBarVisibility="Auto" Visibility="Collapsed">
                        <StackPanel>
                            <Border Style="{StaticResource Card}" Margin="0,0,0,16">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <Image x:Name="AboutLogo" Width="72" Height="72" Margin="0,0,20,0"/>
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <TextBlock Text="Akati OS" FontSize="26" FontWeight="Bold"/>
                                        <TextBlock x:Name="AboutVersion" Text="v1.10.0" Style="{StaticResource Muted}"/>
                                        <TextBlock x:Name="UpdateStatus" Text="" Margin="0,6,0,0" TextWrapping="Wrap"/>
                                        <Button x:Name="UpdateDownload" Style="{StaticResource PillAccent}" HorizontalAlignment="Left" Margin="0,10,0,0" Padding="14,5" Visibility="Collapsed">
                                            <StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource Glyph}" Text="&#xE896;" FontSize="12" Margin="0,0,8,0"/><TextBlock Tag="t:update.download" Text="Download the update"/></StackPanel>
                                        </Button>
                                    </StackPanel>
                                    <Button x:Name="UpdateButton" Grid.Column="2" Style="{StaticResource Primary}" VerticalAlignment="Center">
                                        <StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource Glyph}" Text="&#xE895;" FontSize="13" Margin="0,0,8,0"/><TextBlock Tag="t:quick.update" Text="Check for updates"/></StackPanel>
                                    </Button>
                                </Grid>
                            </Border>
                            <Border Style="{StaticResource Card}" Margin="0,0,0,16">
                                <StackPanel>
                                    <TextBlock Tag="t:links" Text="Links" Style="{StaticResource CardTitle}" Margin="0,0,0,12"/>
                                    <WrapPanel>
                                        <Button x:Name="LinkGithub" Style="{StaticResource Secondary}" Margin="0,0,10,10"><StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource Glyph}" Text="&#xE774;" FontSize="13" Margin="0,0,8,0"/><TextBlock Text="GitHub"/></StackPanel></Button>
                                        <Button x:Name="LinkOptions" Style="{StaticResource Secondary}" Margin="0,0,10,10"><StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource Glyph}" Text="&#xE897;" FontSize="13" Margin="0,0,8,0"/><TextBlock Tag="t:link.options" Text="Options guide"/></StackPanel></Button>
                                        <Button x:Name="LinkAtlas" Style="{StaticResource Secondary}" Margin="0,0,10,10"><StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource Glyph}" Text="&#xE71B;" FontSize="13" Margin="0,0,8,0"/><TextBlock Text="AtlasOS"/></StackPanel></Button>
                                        <Button x:Name="TourStart" Style="{StaticResource Secondary}" Margin="0,0,10,10"><StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource Glyph}" Text="&#xE7BE;" FontSize="13" Margin="0,0,8,0"/><TextBlock Tag="t:tour.start" Text="Take the tour (F1)"/></StackPanel></Button>
                                    </WrapPanel>
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource Card}" Margin="0,0,0,16">
                                <DockPanel>
                                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                                        <Button x:Name="IssuesButton" Style="{StaticResource Secondary}" Margin="0,0,8,0">
                                            <StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource Glyph}" Text="&#xE8BD;" FontSize="13" Margin="0,0,8,0"/><TextBlock Tag="t:report.issues" Text="GitHub issues"/></StackPanel>
                                        </Button>
                                        <Button x:Name="ReportButton" Style="{StaticResource Primary}">
                                            <StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource Glyph}" Text="&#xEBE8;" FontSize="13" Margin="0,0,8,0"/><TextBlock Tag="t:report.button" Text="Create problem report"/></StackPanel>
                                        </Button>
                                    </StackPanel>
                                    <StackPanel Margin="0,0,16,0">
                                        <TextBlock Tag="t:report.title" Text="Report a problem" Style="{StaticResource CardTitle}"/>
                                        <TextBlock Tag="t:report.sub" Text="Saves one .zip on your desktop with the Akati OS logs and PC details (no personal files, your user name is removed). Attach it to a GitHub issue." Style="{StaticResource Muted}" Margin="0,4,0,0"/>
                                    </StackPanel>
                                </DockPanel>
                            </Border>
                            <Border Style="{StaticResource Card}" Margin="0,0,0,16">
                                <StackPanel>
                                    <TextBlock Tag="t:credits" Text="Credits" Style="{StaticResource CardTitle}" Margin="0,0,0,8"/>
                                    <TextBlock Tag="t:credits.text" Text="Akati OS is based on AtlasOS by the Atlas team and is licensed under GPL-3.0. It is not an official AtlasOS project. AME Wizard by Ameliorated." Style="{StaticResource Muted}"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>
                    <!-- Message after a change, with Undo -->
                    <Border x:Name="Toast" VerticalAlignment="Bottom" HorizontalAlignment="Center" Margin="0,0,0,16" Visibility="Collapsed"
                            Background="{DynamicResource Popup}" BorderBrush="{DynamicResource Line}" BorderThickness="1" CornerRadius="12" Padding="16,8,8,8">
                        <Border.Effect><DropShadowEffect BlurRadius="18" ShadowDepth="4" Opacity="0.35"/></Border.Effect>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock x:Name="ToastText" VerticalAlignment="Center" FontSize="13" MaxWidth="460" TextTrimming="CharacterEllipsis"/>
                            <Button x:Name="ToastUndo" Style="{StaticResource Pill}" Margin="14,0,0,0" Padding="12,4" Tag="t:toast.undo" Content="Undo"/>
                        </StackPanel>
                    </Border>
                </Grid>

                <Border Grid.Row="2" BorderBrush="{DynamicResource Popup}" BorderThickness="0,1,0,0">
                    <Grid Margin="28,0">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Ellipse x:Name="StatusDot" Width="7" Height="7" Fill="{DynamicResource Good}" Margin="0,0,8,0"/>
                            <TextBlock x:Name="StatusText" Tag="t:ready" Text="Ready" FontSize="12" Foreground="{DynamicResource MutedBrush}"/>
                        </StackPanel>
                        <TextBlock x:Name="FooterVersion" Text="Akati OS" FontSize="12" Foreground="{DynamicResource MutedBrush}" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                    </Grid>
                </Border>
            </Grid>

            <!-- Welcome (first start) -->
            <Grid x:Name="Welcome" Grid.ColumnSpan="2" Visibility="Collapsed">
                <Border Background="#D8000000" CornerRadius="14"/>
                <Border Style="{StaticResource Card}" Width="600" VerticalAlignment="Center" HorizontalAlignment="Center" Padding="32,28">
                    <StackPanel>
                        <Image x:Name="WelcomeLogo" Width="56" Height="56" HorizontalAlignment="Left"/>
                        <TextBlock Tag="t:welcome.title" Text="Welcome to Akati OS" FontSize="26" FontWeight="Bold" Margin="0,14,0,4"/>
                        <TextBlock Tag="t:welcome.sub" Text="Three quick steps. You can change everything later." Style="{StaticResource Muted}" Margin="0,0,0,20"/>
                        <Grid Margin="0,0,0,14">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <Border Width="30" Height="30" CornerRadius="15" Background="{DynamicResource AccentGradient}" Margin="0,0,14,0"><TextBlock Text="1" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
                            <TextBlock Grid.Column="1" Tag="t:welcome.lang" Text="Language" FontWeight="SemiBold" VerticalAlignment="Center"/>
                            <StackPanel Grid.Column="2" Orientation="Horizontal">
                                <Button x:Name="WelcomeEn" Style="{StaticResource Secondary}" Content="English" Margin="0,0,8,0"/>
                                <Button x:Name="WelcomeTh" Style="{StaticResource Secondary}" Content="ภาษาไทย" Margin="0,0,8,0"/>
                                <Button x:Name="WelcomeVi" Style="{StaticResource Secondary}" Content="Tiếng Việt" Margin="0,0,8,0"/>
                                <Button x:Name="WelcomeId" Style="{StaticResource Secondary}" Content="Bahasa Indonesia"/>
                            </StackPanel>
                        </Grid>
                        <!-- Main game: added to My games with Game boost when it is installed (Set-MainGame) -->
                        <Grid Margin="0,0,0,14">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <Border Width="30" Height="30" CornerRadius="15" Background="{DynamicResource AccentGradient}" Margin="0,0,14,0"><TextBlock Text="2" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,12,0">
                                <TextBlock Tag="t:welcome.game" Text="Your main game" FontWeight="SemiBold"/>
                                <TextBlock Tag="t:welcome.game.d" Text="Game boost starts with it" Style="{StaticResource Muted}" FontSize="12" TextWrapping="Wrap"/>
                            </StackPanel>
                            <Border Grid.Column="2" Background="{DynamicResource CardBg}" BorderBrush="{DynamicResource Line}" BorderThickness="1" CornerRadius="7" Padding="2" VerticalAlignment="Center">
                                <StackPanel Orientation="Horizontal">
                                    <RadioButton x:Name="MainGameValorant" Style="{StaticResource Segment}" GroupName="MainGame" Content="Valorant"/>
                                    <RadioButton x:Name="MainGameFivem" Style="{StaticResource Segment}" GroupName="MainGame" Content="FiveM"/>
                                    <RadioButton x:Name="MainGameCs2" Style="{StaticResource Segment}" GroupName="MainGame" Content="CS2"/>
                                    <RadioButton x:Name="MainGameFortnite" Style="{StaticResource Segment}" GroupName="MainGame" Content="Fortnite"/>
                                    <RadioButton x:Name="MainGameOther" Style="{StaticResource Segment}" GroupName="MainGame" Tag="t:welcome.other" Content="Other"/>
                                </StackPanel>
                            </Border>
                        </Grid>
                        <Grid Margin="0,0,0,14">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <Border Width="30" Height="30" CornerRadius="15" Background="{DynamicResource AccentGradient}" Margin="0,0,14,0"><TextBlock Text="3" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock Tag="t:welcome.apps" Text="Install your gaming apps" FontWeight="SemiBold"/>
                                <TextBlock Tag="t:welcome.apps.d" Text="Steam, Discord, Epic and more" Style="{StaticResource Muted}" FontSize="12"/>
                            </StackPanel>
                            <Button x:Name="WelcomeApps" Grid.Column="2" Style="{StaticResource Secondary}" Tag="t:welcome.open" Content="Open"/>
                        </Grid>
                        <Grid Margin="0,0,0,24">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <Border Width="30" Height="30" CornerRadius="15" Background="{DynamicResource AccentGradient}" Margin="0,0,14,0"><TextBlock Text="4" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock Tag="t:welcome.look" Text="Pick a theme and accent color" FontWeight="SemiBold"/>
                                <TextBlock Tag="t:welcome.look.d" Text="Dark, light or slideshow" Style="{StaticResource Muted}" FontSize="12"/>
                            </StackPanel>
                            <Button x:Name="WelcomeLook" Grid.Column="2" Style="{StaticResource Secondary}" Tag="t:welcome.open" Content="Open"/>
                        </Grid>
                        <DockPanel>
                            <Button x:Name="WelcomeDone" DockPanel.Dock="Right" Style="{StaticResource Primary}" Tag="t:welcome.done" Content="Get started" MinWidth="140"/>
                            <TextBlock Tag="t:welcome.keys" Text="Tip: Ctrl+1 to Ctrl+8 switch pages, Ctrl+F searches the settings." Style="{StaticResource Muted}" FontSize="12" VerticalAlignment="Center" Margin="0,0,12,0"/>
                        </DockPanel>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- Tour: a few steps after the welcome (F1 or About > Take the tour) -->
            <Border x:Name="Tour" Grid.ColumnSpan="2" Style="{StaticResource Card}" Width="400" HorizontalAlignment="Right" VerticalAlignment="Bottom"
                    Margin="0,0,28,52" Padding="22,18" Visibility="Collapsed" BorderBrush="{DynamicResource Accent}" BorderThickness="1.5">
                <StackPanel>
                    <TextBlock x:Name="TourStep" Text="1 / 5" Foreground="{DynamicResource Accent2}" FontWeight="SemiBold" FontSize="12"/>
                    <TextBlock x:Name="TourTitle" Text="" FontSize="18" FontWeight="Bold" Margin="0,4,0,6"/>
                    <TextBlock x:Name="TourText" Text="" Style="{StaticResource Muted}" TextWrapping="Wrap"/>
                    <DockPanel Margin="0,16,0,0">
                        <Button x:Name="TourNext" DockPanel.Dock="Right" Style="{StaticResource Primary}" Content="Next" MinWidth="96"/>
                        <Button x:Name="TourSkip" DockPanel.Dock="Right" Style="{StaticResource Secondary}" Tag="t:tour.skip" Content="Skip" Margin="0,0,8,0"/>
                        <Border/>
                    </DockPanel>
                </StackPanel>
            </Border>

            <!-- What's new: once after an update of Akati OS -->
            <Grid x:Name="WhatsNew" Grid.ColumnSpan="2" Visibility="Collapsed">
                <Border Background="#D8000000" CornerRadius="14"/>
                <Border Style="{StaticResource Card}" Width="580" VerticalAlignment="Center" HorizontalAlignment="Center" Padding="32,28">
                    <StackPanel>
                        <TextBlock x:Name="WhatsNewTitle" Text="What's new" FontSize="24" FontWeight="Bold" Margin="0,0,0,16"/>
                        <StackPanel x:Name="WhatsNewList"/>
                        <Button x:Name="WhatsNewDone" Style="{StaticResource Primary}" Tag="t:new.done" Content="Continue" HorizontalAlignment="Right" MinWidth="140" Margin="0,18,0,0"/>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- Keyboard shortcuts (the ? key) -->
            <Grid x:Name="Keys" Grid.ColumnSpan="2" Visibility="Collapsed">
                <Border x:Name="KeysDim" Background="#B0000000" CornerRadius="14"/>
                <Border Style="{StaticResource Card}" Width="560" VerticalAlignment="Center" HorizontalAlignment="Center" Padding="28,24">
                    <StackPanel>
                        <TextBlock Tag="t:keys.title" Text="Keyboard shortcuts" FontSize="22" FontWeight="Bold" Margin="0,0,0,14"/>
                        <StackPanel x:Name="KeysList"/>
                        <Button x:Name="KeysDone" Style="{StaticResource Primary}" Tag="t:new.done" Content="Continue" HorizontalAlignment="Right" MinWidth="140" Margin="0,16,0,0"/>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- Spotlight: search pages, settings, apps and actions (Ctrl+K) -->
            <Grid x:Name="Spotlight" Grid.ColumnSpan="2" Visibility="Collapsed">
                <Border x:Name="SpotlightDim" Background="#99000000" CornerRadius="14"/>
                <Border x:Name="SpotlightCard" Background="{DynamicResource Popup}" BorderBrush="{DynamicResource FillHover}" BorderThickness="1" CornerRadius="12" Width="640" VerticalAlignment="Top" HorizontalAlignment="Center" Margin="0,80,0,0">
                    <Border.Effect><DropShadowEffect BlurRadius="30" ShadowDepth="6" Opacity="0.5"/></Border.Effect>
                    <StackPanel>
                        <DockPanel Margin="18,14">
                            <TextBlock Style="{StaticResource Glyph}" Text="&#xE721;" FontSize="18" Foreground="{DynamicResource MutedBrush}" Margin="0,0,14,0"/>
                            <Grid>
                                <TextBlock x:Name="SpotlightHint" Tag="t:spot.hint" Text="Search pages, settings, apps and actions" Foreground="{DynamicResource MutedBrush}" FontSize="17" IsHitTestVisible="False" VerticalAlignment="Center"/>
                                <TextBox x:Name="SpotlightBox" Background="Transparent" BorderThickness="0" Foreground="{DynamicResource Text2}" CaretBrush="{DynamicResource Text2}" FontSize="17" VerticalAlignment="Center"/>
                            </Grid>
                        </DockPanel>
                        <Border x:Name="SpotlightLine" Height="1" Background="{DynamicResource Line}" Visibility="Collapsed"/>
                        <StackPanel x:Name="SpotlightResults" Margin="6"/>
                    </StackPanel>
                </Border>
            </Grid>
        </Grid>
    </Border>
</Window>
